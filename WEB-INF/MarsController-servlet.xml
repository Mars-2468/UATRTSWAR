				<ref bean="localeChangeInterceptor"/>
			</list>
		</property>
		<property name="mappings">
			<props></props>
		</property>
	</bean> -->


	<bean id="loggerInterceptor"
		class="com.mars.common.utils.LoggerInterceptor" />

