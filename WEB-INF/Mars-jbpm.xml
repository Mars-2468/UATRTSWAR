	<bean id="springHelper"
		class="org.jbpm.pvm.internal.processengine.SpringHelper">
		<property name="jbpmCfg">
			<value>jbpm.cfg.xml</value>
		</property>
	</bean>

	<bean id="processEngine" factory-bean="springHelper"
		factory-method="createProcessEngine" />

	<bean id="repositoryService" factory-bean="processEngine"
		factory-method="getRepositoryService" />

	<bean id="executionService" factory-bean="processEngine"
		factory-method="getExecutionService" />

	<bean id="taskService" factory-bean="processEngine"
		factory-method="getTaskService" />

	<bean id="historyService" factory-bean="processEngine"
		factory-method="getHistoryService" />

	<bean id="managementService" factory-bean="processEngine"
		factory-method="getManagementService" />

	<bean id="identityService" factory-bean="processEngine"
		factory-method="getIdentityService" />

	<bean id="workflowService" parent="txProxyTemplate">
		<property name="target">
			<ref local="workflowServiceTarget" />
		</property>
	</bean>

	<bean id="workflowServiceTarget"
		class="com.mars.workflow.service.impl.WorkflowServiceImpl">
		<property name="processDefinitions">
			<list>

				<value>/workflow/birthApplication.jpdl.xml</value>
				<value>/workflow/mandapPermission.jpdl.xml</value>
				<value>/workflow/marriageApplication.jpdl.xml</value>
				<value>/workflow/dogLicense.jpdl.xml</value>
				<value>/workflow/water.jpdl.xml</value>
				<value>/workflow/fire.jpdl.xml</value>
				<value>/workflow/marketDepartment.jpdl.xml</value>
				<value>/workflow/propertytax.jpdl.xml</value>
				<value>/workflow/garden.jpdl.xml</value>
				<value>/workflow/ganeshMandapPermission.jpdl.xml</value>
				<value>/workflow/nursingregistration.jpdl.xml</value>
				<value>/workflow/garden.jpdl.xml</value>
				<value>/workflow/townPlanning.jpdl.xml</value>
				<value>/workflow/mtpRegistrationCertificate.jpdl.xml</value>
				<value>/workflow/bioMedicalApplication.jpdl.xml</value>
								<value>/workflow/fireCrackerLicense.jpdl.xml</value>
				<value>/workflow/Tree_Cutting_Workflow.jpdl.xml</value>


			</list>
		</property>
		<property name="repositoryService">
			<ref local="repositoryService" />
		</property>
		<property name="executionService">
			<ref local="executionService" />
		</property>
		<property name="taskService">
			<ref local="taskService" />
		</property>
		<property name="managementService">
			<ref local="managementService" />
		</property>
		<property name="historyService">
			<ref local="historyService" />
		</property>
		<property name="identityService">
			<ref local="identityService" />
		</property>
		<!-- <property name="workflowProcessDetailsService"> <ref local="workflowProcessDetailsService" 
			/> </property> -->
		<property name="velocityEngine">
			<ref bean="velocityEngine" />
		</property>
	</bean>

