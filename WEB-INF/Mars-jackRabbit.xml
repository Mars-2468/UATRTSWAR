<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:util="http://www.springframework.org/schema/util"
	xsi:schemaLocation="
       http://www.springframework.org/schema/beans 
       http://www.springframework.org/schema/beans/spring-beans-2.0.xsd
       http://www.springframework.org/schema/util 
       http://www.springframework.org/schema/util/spring-util-2.0.xsd">

	<bean id="rmiClientFactory"
		class="org.apache.jackrabbit.rmi.client.ClientRepositoryFactory" />

	<bean id="repository" factory-bean="rmiClientFactory"
		factory-method="getRepository">
		<constructor-arg value="${jackrabbit.repository.dms.url}/DMS-Admin" />
	</bean>

	<bean id="jcrSessionFactory"
		class="org.springmodules.jcr.JcrSessionFactory">
		<property name="repository" ref="repository" />
		<property name="credentials">
			<bean class="javax.jcr.SimpleCredentials">
				<constructor-arg index="0" value="${jackrabbit.repository.dms.username}" />
				<constructor-arg index="1" value="${jackrabbit.repository.dms.password}" />
			</bean>
		</property>
		<property name="workspaceName" value="${jackrabbit.repository.dms.workspacename}" />
	</bean>

	<bean id="jcrTemplate" class="org.springmodules.jcr.JcrTemplate">
		<property name="sessionFactory" ref="jcrSessionFactory" />
		<property name="allowCreate" value="true" />
	</bean>

	<bean id="jcrTransactionManager"
		class="org.springmodules.jcr.jackrabbit.LocalTransactionManager">
		<property name="sessionFactory" ref="jcrSessionFactory" />
	</bean>

	<!-- transaction proxy for Jcr services/facades -->
	<bean id="txProxyJcrTemplate" abstract="true"
		class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
		<property name="proxyTargetClass" value="true" />
		<property name="transactionManager" ref="jcrTransactionManager" />
		<property name="transactionAttributes">
			<props>
				<prop key="save\*">PROPAGATION_REQUIRED</prop>
				<prop key="\*">PROPAGATION_REQUIRED, readOnly</prop>
			</props>
		</property>
	</bean>

	<bean id="contentPublishService" parent="txProxyJcrTemplate">
		<property name="target">
			<ref local="contentPublishServiceTarget" />
		</property>
	</bean>

	<bean id="contentPublishServiceTarget"
		class="com.mars.dms.service.impl.ContentPublishServiceImpl">
		<property name="template">
			<ref local="jcrTemplate" />
		</property>
	</bean>

	<bean id="contentRetrieveService" parent="txProxyJcrTemplate">
		<property name="target">
			<ref local="contentRetrieveServiceTarget" />
		</property>
	</bean>

	<bean id="contentRetrieveServiceTarget"
		class="com.mars.dms.service.impl.ContentRetrieveServiceImpl">
		<property name="template">
			<ref local="jcrTemplate" />
		</property>
	</bean>


	<bean id="workspaceService" parent="txProxyJcrTemplate">
		<property name="target">
			<ref local="workspaceServiceTarget" />
		</property>
	</bean>

	<bean id="workspaceServiceTarget"
		class="com.mars.dms.service.impl.WorkspaceServiceImpl">
		<property name="template">
			<ref local="jcrTemplate" />
		</property>
	</bean>

	<!-- Setting Services Ward-->
	<bean id="dmsDocumentService" parent="txProxyTemplate">
		<property name="target">
			<ref local="dmsDocumentServiceTarget" />
		</property>
	</bean>

	<bean id="dmsDocumentServiceTarget"
		class="com.mars.dms.service.impl.DmsDocumentServiceImpl">
		<property name="dmsDocumentDAO">
			<ref local="dmsDocumentDAO" />
		</property>
		<property name="contentPublishService">
			<ref local="contentPublishService" />
		</property>
		<property name="contentRetrieveService">
			<ref local="contentRetrieveService" />
		</property>				
	</bean>

	<bean id="dmsDocumentDAO"
		class="com.mars.dms.dao.impl.DmsDocumentDAOImpl">
		<property name="sessionFactory">
			<ref bean="sessionFactory" />
		</property>
	</bean>

		<!-- Setting Services DmsDocumentCheckListService-->
	<bean id="dmsDocumentCheckListService" parent="txProxyTemplate">
	<property name="target"><ref local="dmsDocumentCheckListServiceTarget"/></property>
	</bean>
	
	<bean id="dmsDocumentCheckListServiceTarget" class="com.mars.dms.service.impl.DmsDocumentCheckListServiceImpl">
		<property name="dmsDocumentCheckListDAO"><ref local="dmsDocumentCheckListDAO"/></property>
		<property name="contentPublishService">
			<ref local="contentPublishService" />
		</property>
		<property name="contentRetrieveService">
			<ref local="contentRetrieveService" />
		</property>	
	</bean>
	
	<bean id="dmsDocumentCheckListDAO" class="com.mars.dms.dao.impl.DmsDocumentCheckListDAOImpl">
	<property name="sessionFactory"><ref bean="sessionFactory"/></property>
	</bean>	
	
	<bean id="documentTypeService"
		class="org.springframework.remoting.rmi.RmiProxyFactoryBean">
		<property name="serviceUrl"
			value="${jackrabbit.repository.dms.url}/DocumentTypeService" />
		<property name="serviceInterface"
			value="com.mars.dms.service.DocumentTypeService" />
	</bean>
</beans>
