<?xml version="1.0" encoding="UTF-8"?>

<process name="RTI_Application_Request" xmlns="http://jbpm.org/4.4/jpdl">
	<start>
		<transition to="Verify Application Request Details" />
	</start>

	<task name="Verify Application Request Details" assignee="#{HOD_user}">
		<transition name="Approve" to="Approve Application Request" />
		<transition name="End" to="end" />
	</task>
	
	<task name="Approve Application Request" assignee="#{PIO_user}">
		<transition name="Approve" to="end" />
		<transition name="Re-Verify" to="Verify Application Request Details" />
	</task>

	<end name="end" />
</process>