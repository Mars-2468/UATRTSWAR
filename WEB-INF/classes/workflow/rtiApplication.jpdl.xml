<?xml version="1.0" encoding="UTF-8"?>

<process name="rtiApplication" xmlns="http://jbpm.org/4.4/jpdl">
	<start>		
		<transition to="Accept" />
	</start>
	
	<task name="Accept" assignee="#{Acceptance}">
		<transition name="Send-For-Verification" to="Verification" />			
	</task>
	
	<task name="Verification" assignee="#{Verification}">
		<transition name="Send-For-Approval" to="Approval" />	
		<transition name="Re-Verify" to="Accept" />
	</task>
		
	<task name="Approval" assignee="#{Approve}">
		<transition name="Approve" to="Application Closing" />
		<transition name="Re-Verify" to="Verification" />
	</task>
	
	<task name="Application Closing" assignee="#{CloseApplication}">
		<transition name="Close-Application" to="end" />		
	</task>
	
	<end name="end" />
</process>