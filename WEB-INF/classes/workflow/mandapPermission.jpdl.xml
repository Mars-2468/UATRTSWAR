<?xml version="1.0" encoding="UTF-8"?>

<process name="mandapPermission" xmlns="http://jbpm.org/4.4/jpdl">
	<start>		
		<transition to="Mandap Approval" />
	</start>
	
		
	<task name="Mandap Approval" assignee="#{CloseApplication}">
		<transition name="Close-Application" to="end" />
		<transition name="Reject" to="end" />		
	</task>
	
	<end name="end" />
</process>





