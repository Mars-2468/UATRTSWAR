<!-- $Id: log4j.xml,v 1.26.2.10 2006/04/21 17:29:20 csuconic Exp $ -->

<!--
   | For more configuration infromation and examples see the Jakarta Log4j
   | owebsite: http://jakarta.apache.org/log4j
${jboss.server.log.dir}
 -->

<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/" debug="false">

	<appender name="RTI_LOG" class="org.apache.log4j.RollingFileAppender">
		<param name="File" value="${jboss.server.log.dir}/RTI.log"/>
		<param name="Append" value="true"/>
		<param name="MaxFileSize" value="3000KB"/>
    	<param name="MaxBackupIndex" value="10"/>
		<layout class="org.apache.log4j.PatternLayout">
			<param name="ConversionPattern" value="[%d{ddMMMyyyy HH:mm:ss}] [%c] [%-5p] [%C{1}.%M] - %m\n"/>
		</layout>
  	</appender>
  	
	<appender name="RTI_Console" class="org.apache.log4j.ConsoleAppender">
      	<param name="Target" value="System.out"/>
	    <param name="Threshold" value="WARN"/>
	    <layout class="org.apache.log4j.PatternLayout">
	         <!-- The default pattern: Date Priority [Category] Message\n -->
	         <param name="ConversionPattern" value="%d{ABSOLUTE} %-5p [%c{1}] %m%n"/>
	    </layout>
	</appender>

 	
	<category name="com.mars">
		<priority value="DEBUG"/>
	    <appender-ref ref="RTI_LOG"/>		 
   </category>
   
   <category name="org.apache.commons.digester">
        <priority value="DEBUG"/>
	    <appender-ref ref="RTI_Console"/>
   </category>
   
 </log4j:configuration>