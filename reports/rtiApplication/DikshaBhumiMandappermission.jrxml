			</staticText>
			<staticText>
				<reportElement x="48" y="594" width="505" height="40" uuid="f7ccf542-e4a9-4612-ada6-a6d0bdd91273"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[रिट पिटीशन क्र. ६१७७/२००६ मनोहर खोरगडे वि. म.न.पा व ईतर या मध्ये मा. उच्च न्यायालय खंडपीठ यांनी वेळोवेळी पारित केल्याला आदेशाचे उल्घन होणार नाही. याची दक्षता घ्यावी.]]></text>
			</staticText>
			<staticText>
				<reportElement x="19" y="594" width="25" height="30" uuid="15e43124-cb37-4d98-8689-d6299a589965">
					<property name="com.jaspersoft.studio.unit.y" value="pixel"/>
				</reportElement>
				<textElement>
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[16]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="288" width="508" height="31" uuid="ab174c07-5a28-4403-b70e-3f8674f1f156"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[रस्त्यावर चूल पेटवून स्वयंपाक करण्यात सक्त मनाई आहे असे केल्यास रु. २०००/- दंड आकारण्यात येईल किंवा जप्त करण्यात येईल. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="49" y="634" width="504" height="20" uuid="3a4e257e-aa3c-4589-85a2-5d5f309a3bf4"/>
				<textElement>
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[नियम व अटी चे पालन न करण्यावर फौजदारी गुन्हा दाखल करण्यात येईल.

]]></text>
			</staticText>
			<staticText>
				<reportElement x="19" y="634" width="27" height="20" uuid="e57ae627-7152-433d-be95-329c6772908d"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<text><![CDATA[17]]></text>
			</staticText>
			<staticText>
				<reportElement x="346" y="740" width="160" height="21" uuid="489f2193-1760-4b59-9aaa-ad1ce86a6b7c"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<text><![CDATA[उप अभियंता]]></text>
			</staticText>
			<staticText>
				<reportElement x="306" y="760" width="246" height="20" uuid="3c12b13e-ef26-42a0-b57a-db3746a09aff"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<text><![CDATA[नागपूर महानगरपालिका, नागपूर. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="44" y="251" width="510" height="36" uuid="ce005880-2d08-48f9-86c7-2ca7bc014824"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[प्रस्तुत धोरण अंतर्गत मनापाद्वारे देण्यात आलेली परवानगी कोणतेही कारण न सागंताना परत घेण्याचे किंवा निरस्तर करण्याचे संपुर्ण अधिकार महानगरपालिका आयुक्तांकडे राहतो.]]></text>
			</staticText>
		</band>
