<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Final_NOC_Report" pageWidth="595" pageHeight="942" whenNoDataType="AllSectionsNoDetail" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30" uuid="8f2c1a10-1a2b-4c3d-9e4f-5a6b7c8d9e0f">
	<property name="net.sf.jasperreports.export.pdf.embedded" value="true"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="EGOVNMC_RTS"/>
	<parameter name="rtiapplrefid" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    fcc.*,
    ra.applicant_name,
    ra.rti_application_number,
    ra.created_date,
    SPLIT_PART(ra.pdf_upload_from_portal,',',1) AS doc1_url,
    SPLIT_PART(ra.pdf_upload_from_portal,',',2) AS doc2_url,
    SPLIT_PART(ra.pdf_upload_from_portal,',',3) AS doc3_url,
    SPLIT_PART(ra.pdf_upload_from_portal,',',4) AS doc4_url,
    SPLIT_PART(ra.pdf_upload_from_portal,',',5) AS doc5_url,
    SPLIT_PART(ra.pdf_upload_from_portal,',',6) AS doc6_url,
    SPLIT_PART(ra.pdf_upload_from_portal,',',7) AS doc7_url
FROM egovrti.fire_compliance_certificate fcc
JOIN egovrti.rti_application ra ON fcc.rti_ref_id = ra.rti_application_id
JOIN egovrti.fire_compliance_measure fcm ON fcc.fire_compliance_certificate_id =fcm.fire_compliance_certificate_id

WHERE fcc.rti_ref_id = $P{rtiapplrefid}
LIMIT 1]]>
	</queryString>
