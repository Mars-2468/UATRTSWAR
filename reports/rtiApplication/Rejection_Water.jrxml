	<queryString>
		<![CDATA[select tc.*,TO_CHAR(ra.created_date ::timestamp, 'DD/MM/YYYY')  from egovrti.tree_cuting tc 
join egovrti.rti_application ra on ra.rti_application_id =tc.rti_ref_id 
where ra.rti_application_id  =$P{rtiapplrefid};]]>
	</queryString>
