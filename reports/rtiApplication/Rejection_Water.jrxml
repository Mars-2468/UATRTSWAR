	<detail>
		<band height="561" splitType="Stretch">
			<textField>
				<reportElement x="27" y="247" width="500" height="100" uuid="26741959-76de-486d-9964-56a897695086"/>
				<textElement>
					<font fontName="Arial Unicode MS"/>
				</textElement>
				<textFieldExpression><![CDATA["             उपरोक्त संदर्भांकित विषयाच्या अनुषंगाने कळविण्यात येते कि, "+$F{address}+","+$F{locationoftree}+" येथील झाडास कापणी करण्याची परवानगी मागितलेली आहे. "+"\n"+"    तेव्हा, "+$F{address}+","+$F{locationoftree}+"  झाडाची  प्रथम दर्शनी पाहणी केली असता सध्या स्थितीत झाडास  कापणी  करण्याची आवशक्यता वाटत नाही. नैसर्गिक रित्या झाड अथवा झाडाची फांदी पडल्यास  म.न.पा. नागपूर जवाबदार राहणार नाही. "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="21" y="86" width="144" height="20" uuid="f59a18b8-0d04-41e7-8d31-ee16d9c02482"/>
				<textElement>
					<font fontName="Arial Unicode MS"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{address}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="21" y="64" width="144" height="20" uuid="ecc2f92c-2654-4223-bcbf-476a2aefe3cb"/>
				<textElement>
					<font fontName="Arial Unicode MS"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{full_name}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="21" y="35" width="81" height="21" uuid="777bf7c4-6285-41b9-95cf-7e7a98bed536"/>
				<textElement>
					<font fontName="Arial Unicode MS"/>
				</textElement>
				<text><![CDATA[प्रति,  ]]></text>
			</staticText>
			<staticText>
				<reportElement x="377" y="489" width="150" height="20" uuid="e80b738f-bab6-469a-ac8e-5e0da56b013d"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[उद्यान अधिक्षक]]></text>
			</staticText>
			<staticText>
				<reportElement x="356" y="511" width="190" height="21" uuid="ddaf5ca0-3141-493d-96cb-0b2850cff25b"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[नागपूर महानगरपालिका, नागपूर]]></text>
			</staticText>
			<textField>
				<reportElement x="21" y="144" width="518" height="36" uuid="8432b187-07e1-4b9d-9a9e-eb53eeb9613b"/>
				<textElement>
					<font fontName="Arial Unicode MS"/>
				</textElement>
				<textFieldExpression><![CDATA["विषय :-  "+$F{resone_tree_cuting}+" झाडे तोडण्याबाबत प्लॉट नं. 8, पब्लिक को-ऑप. हाउसिंग सोसायटी, अत्रे लेआऊट, नागपूर येथील आपल्या घरपरिसरात सुरक्षाभिंतीच्या लगत असलेल्या दोन सागवानच्या झाडाबाबत. "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="21" y="190" width="518" height="27" uuid="eb9a6787-32d2-42cd-ab59-46f404c20f24"/>
				<textElement>
					<font fontName="Arial Unicode MS"/>
				</textElement>
				<textFieldExpression><![CDATA["संदर्भ :- कार्यालयास प्राप्त आपले दिनांक "+$F{to_char}+"  चा अर्ज."]]></textFieldExpression>
			</textField>
		</band>
	</detail>
