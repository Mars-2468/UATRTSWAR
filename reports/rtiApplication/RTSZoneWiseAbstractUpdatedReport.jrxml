	<property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Egov_Nmc"/>
	<parameter name="FROM_DATE" class="java.lang.String"/>
	<parameter name="TO_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    COUNT(*) FILTER (WHERE tc.ws IN (0,1,2,3,5,9,10,11)) AS total_application,
    COUNT(*) FILTER (WHERE tc.ws IN (9,10,11,0)) AS applicationInProcess,
    COUNT(*) FILTER (WHERE tc.ws = 1) AS certificateIssue,
    COUNT(*) FILTER (WHERE tc.ws = 5) AS appRejected,
    COUNT(*) FILTER (WHERE tc.ws = 2) AS readyToIssue,
    COUNT(*) FILTER (WHERE tc.ws = 3) AS appPayentpending,

    CASE
        WHEN tc.zone_no = 1 THEN 'Zone No.1 - Laxmi Nagar (लक्ष्मी नगर)'
        WHEN tc.zone_no = 2 THEN 'Zone No.2 - Dharmpeth (धरमपेठ)'
        WHEN tc.zone_no = 3 THEN 'Zone No.3 - Hanuman Nagar (हनुमान नगर)'
        WHEN tc.zone_no = 4 THEN 'Zone No.4 - Dhantoli (धंतोली)'
        WHEN tc.zone_no = 5 THEN 'Zone No.5 - Nehru Nagar (नेहरू नगर)'
        WHEN tc.zone_no = 6 THEN 'Zone No.6 - Gandhibag (गांधीबाग)'
        WHEN tc.zone_no = 7 THEN 'Zone No.7 - Satranjipura (सतरंजीपुरा)'
        WHEN tc.zone_no = 8 THEN 'Zone No.8 - Lakadganj (लकडगंज)'
        WHEN tc.zone_no = 9 THEN 'Zone No.9 - Aashi Nagar (आशी नगर)'
        WHEN tc.zone_no = 10 THEN 'Zone No.10 - Mangalwari (मंगळवारी)'
        ELSE 'No Zone Assigned'
    END AS zoneName,

    tc.zone_no

FROM (
    SELECT
        ra.workflow_status AS ws,

        CASE
            WHEN TRIM(ra."zone") ~ '^[0-9]+$'
            THEN TRIM(ra."zone")::integer
            ELSE 0
        END AS zone_no,

        ra.rti_application_number

    FROM egovrti.rti_application ra
    WHERE
        ra.rti_application_number IS NOT NULL
        AND ra.rti_application_number <> ''

        -- 🔥 FULL DAY SAFE DATE FILTER
        AND to_timestamp(ra.created_date, 'DD/MM/YYYY HH24:MI:SS')
            >= to_timestamp($P{FROM_DATE}, 'DD/MM/YYYY')

        AND to_timestamp(ra.created_date, 'DD/MM/YYYY HH24:MI:SS')
            < (
                to_timestamp($P{TO_DATE}, 'DD/MM/YYYY') + INTERVAL '1 day'
              )

) tc

GROUP BY tc.zone_no
ORDER BY tc.zone_no;]]>
	</queryString>
	<field name="total_application" class="java.lang.Long"/>
	<field name="applicationinprocess" class="java.lang.Long"/>
	<field name="certificateissue" class="java.lang.Long"/>
	<field name="apprejected" class="java.lang.Long"/>
	<field name="readytoissue" class="java.lang.Long"/>
	<field name="apppayentpending" class="java.lang.Long"/>
	<field name="zonename" class="java.lang.String"/>
	<field name="zone_no" class="java.lang.Integer"/>
	<variable name="t1" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{total_application}]]></variableExpression>
	</variable>
	<variable name="t2" class="java.lang.Integer" calculation="Sum">
