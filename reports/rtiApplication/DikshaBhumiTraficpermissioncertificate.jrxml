			<frame>
				<reportElement x="3" y="408" width="557" height="220" uuid="133349b0-3dc0-4358-816c-b6c2554f7842"/>
				<staticText>
					<reportElement x="40" y="-12" width="507" height="20" uuid="9a1e2210-0bcb-4d30-814f-2f75cf5cb571"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[अस्थाई मंडप तेथील वाहतुकीस अडथळा निर्माण होईल अशा प्रकारे उभारू नये.]]></text>
				</staticText>
				<staticText>
					<reportElement x="1" y="-12" width="39" height="20" uuid="14ab9225-1fee-47b2-b8d9-785b741d8695"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[१.]]></text>
				</staticText>
				<staticText>
					<reportElement x="40" y="8" width="510" height="20" uuid="1221e618-2f7d-47c6-a5aa-866362ba60a5"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[दीक्षा भूमी करिता येणाऱ्या लोकांची वाहनांचे पार्किग करिता स्वतंत्र व्यवस्था करावी.
]]></text>
				</staticText>
				<staticText>
					<reportElement x="2" y="8" width="34" height="20" uuid="aaee4a5d-aec2-4564-b96c-1265c11873e4"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[२]]></text>
				</staticText>
				<staticText>
					<reportElement x="39" y="28" width="511" height="20" uuid="929d2f38-1070-4689-9951-ff2f2fde7c18"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[अस्थाई मंडप पुढे स्वयंसेवक नेमून वाहतुकीस अडथळा होणार नाही याबाबत आयोजकांनी दक्षता घ्यावी.]]></text>
				</staticText>
				<staticText>
					<reportElement x="1" y="28" width="36" height="20" uuid="f7010bdc-8c58-4aa9-9159-d5f893dec4c6"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[३ ]]></text>
				</staticText>
				<staticText>
					<reportElement x="40" y="48" width="503" height="20" uuid="d65cd0e3-94c6-44a7-b31c-3025e668d232"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[उपरोक्त प्रमाणे मापाचे मंडप उभारण्यात येतील याबाबत आयोजकांनी दक्षता घ्यावी. परवानगी पत्र जवळ बाळगावे.]]></text>
				</staticText>
				<staticText>
					<reportElement x="0" y="48" width="39" height="20" uuid="b5334822-afae-4d6d-aa5e-5d5069d1f7af"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[४]]></text>
				</staticText>
				<staticText>
					<reportElement x="41" y="68" width="501" height="20" uuid="28cd3f1b-ea5a-46ee-b9a2-3e6b81625b5b"/>
					<textElement textAlignment="Justified">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[दिलेल्या कालावधी प्रमाणे वेळेत मंडप काढून घेण्याची जबाबदारी अर्जदार यांची राहील.]]></text>
				</staticText>
				<staticText>
					<reportElement x="-2" y="68" width="42" height="20" uuid="f8b764eb-771c-4627-bac9-b6aca5aa5b7e"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[५]]></text>
				</staticText>
				<staticText>
					<reportElement x="39" y="88" width="516" height="40" uuid="eb84eec3-2606-4e73-a5f6-08ebd8a2bbd0"/>
					<textElement textAlignment="Justified">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[अस्थाई मंडप जवळ कोणतेही वाहन पार्क होणार नाही. तसेच आकस्मिक सेवेतील वाहनांचे (उदा. रुग्णवाहिका, अग्निशामक, पोलीस इत्यादी वाहने) वाहतुकीस अडथळा होणार नाही, याची दक्षता घ्यावी.]]></text>
				</staticText>
				<staticText>
					<reportElement x="1" y="88" width="36" height="20" uuid="9d9da28d-7265-4110-a1c6-44e0a182200b"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[६]]></text>
				</staticText>
				<staticText>
					<reportElement x="2" y="128" width="35" height="20" uuid="42e6adc8-2ad7-4a2c-a7f6-01ea4241a2ad"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[७]]></text>
				</staticText>
				<staticText>
					<reportElement x="42" y="188" width="515" height="20" uuid="71b5157b-a72e-4aa6-91eb-a5d9a59eb309"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[सदरचे पत्र वाहतूक दृष्ट्या ना-हरकत पत्र आहे. परवानगी नाही.]]></text>
				</staticText>
				<staticText>
					<reportElement x="2" y="148" width="35" height="20" uuid="096fb126-fbaa-4e5a-89ee-7924f5def6f0"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[८]]></text>
				</staticText>
				<staticText>
					<reportElement x="6" y="188" width="34" height="20" uuid="9aa275dc-1735-4ca2-8b32-4e7d3407d9b9"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[९ ]]></text>
				</staticText>
				<staticText>
					<reportElement x="40" y="128" width="514" height="20" uuid="0b443914-c844-4386-a084-c566e5e82b58"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[पोलिसांनी वेळोवेळी दिलेल्या सूचनांचे पालन करावे.]]></text>
				</staticText>
				<staticText>
					<reportElement x="40" y="148" width="514" height="40" uuid="4eb32011-efeb-4205-929a-3f824cde1b54"/>
					<textElement textAlignment="Justified">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[मा. उच्च न्यायालय खंडपीठ, नागपूर यांनी रिट पिटीशन क्र. ६१७७/२००६ अन्वये दिलेल्या आदेशानुसार मंडप स्वागतद्वार/पेंडॉल/कमानी हे सार्वजनिक रोड किंवा चौका किंवा फुटपाथवर बांधता येणार नाही.]]></text>
				</staticText>
			</frame>
			<staticText>
				<reportElement x="360" y="648" width="160" height="20" uuid="a4561287-dbad-41b2-ba4a-68f71b2b3c47"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<text><![CDATA[वरिष्ठ पोलिस निरीक्षक,]]></text>
			</staticText>
			<staticText>
				<reportElement x="336" y="668" width="210" height="30" uuid="aba4a1ab-3a92-4a3f-ab42-389ce7852caf"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="16"/>
				</textElement>
				<text><![CDATA[वाहतूक परिमंडळ, नागपूर शहर.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="317" width="552" height="90" uuid="a3df0dd9-799a-4a5e-b8aa-ffb226b60353"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[नमूद अर्जाचे अनुषगाने बिट अधिकारी व पोलीस स्टेशनचे खुपिया कर्मचारी यांचे कडून अस्थाई मंडप उभारण्यात येणाऱ्या ठिकाणाची पाहणी करण्यात आलेली आहे. नमूद ठिकाण हे नागपूर येथील रस्त्याचे कडेला मोकळ्या जागेतील आहे. सदर ठिकाणी १० x १० फुटाचा मापाचा अस्थाई मंडप उभारल्यास वाहतुकीस अडथळा होणार असल्याचे दिसून येत नसल्याने अर्जदाराचे विनंतीवरून खालील अटी प्रमाणे उपरोक्त ठिकाणी अस्थाई मंडप उभारण्या करिता परवानगी देण्यास या कार्यालयाची हरकत आहे / हरकत नाही.]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="708" width="445" height="30" uuid="40e1c363-d949-4cc6-be90-ed2074339c4e"/>
				<textElement>
					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<text><![CDATA[प्रत सविनय सादर :- मा. पोलीस उप आयुक्त, वाहतूक विभाग, नागपूर शहर.]]></text>
			</staticText>
		</band>
	</title>
</jasperReport>
