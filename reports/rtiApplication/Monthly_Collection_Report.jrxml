	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="NEW_DATAADAPTER.xml"/>
	<parameter name="month" class="java.lang.String"/>
	<parameter name="year" class="java.lang.String"/>
	<parameter name="zone" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    TO_CHAR(TO_DATE(date, 'YYYY-MM-DD'), 'DD-Mon-YYYY') AS date_formatted,
    COUNT(*) AS no_of_receipts,
    SUM(amount) AS daily_total
FROM
    egovrti.misc_application
WHERE
    EXTRACT(MONTH FROM TO_DATE(date, 'YYYY-MM-DD')) = $P{month}
   AND EXTRACT(YEAR FROM TO_DATE(date, 'YYYY-MM-DD')) = $P{year}
    AND ($P{zone} IS NULL OR zone = $P{zone})
GROUP BY
    TO_CHAR(TO_DATE(date, 'YYYY-MM-DD'), 'DD-Mon-YYYY')
ORDER BY
    TO_DATE(TO_CHAR(TO_DATE(date, 'YYYY-MM-DD'), 'DD-Mon-YYYY'), 'DD-Mon-YYYY');]]>
	</queryString>
	<field name="date_formatted" class="java.lang.String"/>
	<field name="no_of_receipts" class="java.lang.Long"/>
	<field name="daily_total" class="java.math.BigDecimal"/>
	<variable name="s .no" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[new Integer(1)]]></variableExpression>
	</variable>
	<variable name="no_of_receipts" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{no_of_receipts}]]></variableExpression>
	</variable>
	<variable name="grand_total" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{daily_total}]]></variableExpression>
	</variable>
