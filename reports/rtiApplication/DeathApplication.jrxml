				</textElement>
				<textFieldExpression><![CDATA["List of Documents (with attachment) (दस्तऐवजांची यादी (संलग्नकांसह)) :"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="595" y="-109" width="365" height="30" uuid="5e9a5dfc-47e1-4049-bd97-cd514befd3cb">
					<property name="com.jaspersoft.studio.unit.y" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<textFieldExpression><![CDATA["Note: Upload Below Files only .pdf(Max upto 2Mb) "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="-78" width="960" height="25" uuid="bcfe6c88-8691-4a74-9001-ebd384ca3bba">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<textFieldExpression><![CDATA["1. Deceased ID Proof (Aadhar/PAN/Voting Card/T.C./etc)(मृत व्यक्तीचा ओळखपत्र पुरावा (आधार/पॅन/मतदान कार्ड/टी.सी./इ.)) :"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="-52" width="960" height="25" uuid="41c8e6d9-dfc3-4a55-8b8b-93bb71b50f7f">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<textFieldExpression><![CDATA["2. Applicant's ID Proof (Aadhar/PAN/Voting Card/T.C./etc) (अर्जदाराचा ओळखपत्र पुरावा (आधार/पॅन/मतदान कार्ड/टी.सी./इ.)) :"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="-26" width="960" height="25" uuid="3b9d425e-e0df-48fd-bf9d-cd5e86cbc513">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<textFieldExpression><![CDATA["3. Certificate issued by Correspondent (ward/Aasha member)(बातमीदाराने जारी केलेले प्रमाणपत्र(प्रभाग/आशा सदस्य))"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="0" width="960" height="25" uuid="779b0556-f0c4-460f-b573-5d7353649b19">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="14"/>
