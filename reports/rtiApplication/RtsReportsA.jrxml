	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="egvNmc"/>
	<parameter name="FROM_DATE" class="java.lang.String"/>
	<parameter name="TO_DATE" class="java.lang.String"/>
	<parameter name="amc_logo" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    dm.department_name_mar , 
    rs.marathi_label_service , 
    ra.subject,
    ra.department ,
    rs.sla,
    ra.rti_service_id,
    COUNT(*) AS total_applications,
    COALESCE(rejected_counts.rejected, 0) AS rejected,
    COALESCE(process_counts.process, 0) AS process,
    COALESCE(certificate_issue_counts.certificate_issue, 0) AS certificate_issue,
    COALESCE(ready_to_issue_counts.ready_to_issue, 0) AS ready_to_issue,
    coalesce(rejected_counts.rejected_null_remarks, 0) as rejected_null_remarks,
	coalesce(rejected_counts.rejected_non_null_remarks, 0) as rejected_non_null_remarks,
    COALESCE(app_payment_pending_counts.app_payment_pending, 0) AS app_payment_pending
FROM 
    egovrti.rti_application ra
LEFT JOIN egovcommon.department_master  dm ON dm.department_name  = ra.department 
LEFT JOIN egovrti.rti_services   rs ON rs.service_id  = ra.rti_service_id  
LEFT JOIN (
    SELECT 
        ra1.department,
        ra1.rti_service_id,
        COUNT(ra1.rti_application_id) AS rejected,
        COUNT(case when ra1.remarks is null then 1 end) as rejected_null_remarks,
		COUNT(case when ra1.remarks is not null then 1 end) as rejected_non_null_remarks
    FROM 
        egovrti.rti_application ra1
    WHERE 
        ra1.workflow_status NOT IN (1, 0, 2, 3)
    GROUP BY 
        ra1.department, ra1.rti_service_id
) AS rejected_counts ON ra.department = rejected_counts.department AND ra.rti_service_id = rejected_counts.rti_service_id
LEFT JOIN (
    SELECT 
        ra2.department,
        ra2.rti_service_id,
        COUNT(ra2.rti_application_id) AS process
    FROM 
        egovrti.rti_application ra2
    WHERE 
        ra2.workflow_status NOT IN (1, 5, 2, 3)
    GROUP BY 
        ra2.department, ra2.rti_service_id
) AS process_counts ON ra.department = process_counts.department AND ra.rti_service_id = process_counts.rti_service_id
LEFT JOIN (
    SELECT 
        ra3.department,
        ra3.rti_service_id,
        COUNT(ra3.rti_application_id) AS certificate_issue
    FROM 
        egovrti.rti_application ra3
    WHERE 
        ra3.workflow_status NOT IN (0, 5, 2, 3)
    GROUP BY 
        ra3.department, ra3.rti_service_id
) AS certificate_issue_counts ON ra.department = certificate_issue_counts.department AND ra.rti_service_id = certificate_issue_counts.rti_service_id
LEFT JOIN (
    SELECT 
        ra4.department,
        ra4.rti_service_id,
        COUNT(ra4.rti_application_id) AS ready_to_issue
    FROM 
        egovrti.rti_application ra4
    WHERE 
        ra4.workflow_status NOT IN (1, 5, 0, 3)
    GROUP BY 
        ra4.department, ra4.rti_service_id
) AS ready_to_issue_counts ON ra.department = ready_to_issue_counts.department AND ra.rti_service_id = ready_to_issue_counts.rti_service_id
LEFT JOIN (
    SELECT 
        ra5.department,
        ra5.rti_service_id,
        COUNT(ra5.rti_application_id) AS app_payment_pending
    FROM 
        egovrti.rti_application ra5
    WHERE 
        ra5.workflow_status NOT IN (1, 5, 2, 0)
    GROUP BY 
        ra5.department, ra5.rti_service_id
) AS app_payment_pending_counts ON ra.department = app_payment_pending_counts.department AND ra.rti_service_id = app_payment_pending_counts.rti_service_id
WHERE 
    CAST(ra.registration_date AS DATE) BETWEEN TO_DATE($P{FROM_DATE}, 'DD/MM/YYYY') AND TO_DATE($P{TO_DATE}, 'DD/MM/YYYY')
GROUP BY 
    dm.department_name_mar, 
    rs.marathi_label_service,
    rs.sla,
    ra.subject, 
    rejected_counts.rejected, 
    process_counts.process, 
    certificate_issue_counts.certificate_issue, 
    ready_to_issue_counts.ready_to_issue, 
    ra.department ,
    ra.rti_service_id ,
    rejected_counts.rejected_null_remarks,
	rejected_counts.rejected_non_null_remarks,
    app_payment_pending_counts.app_payment_pending,
    dm.department_id 
order by 
dm.department_id ;]]>
	</queryString>
	<field name="department_name_mar" class="java.lang.String"/>
	<field name="marathi_label_service" class="java.lang.String"/>
	<field name="subject" class="java.lang.String"/>
	<field name="department" class="java.lang.String"/>
	<field name="sla" class="java.lang.String"/>
	<field name="rti_service_id" class="java.lang.Integer"/>
	<field name="total_applications" class="java.lang.Long"/>
	<field name="rejected" class="java.lang.Long"/>
	<field name="process" class="java.lang.Long"/>
	<field name="certificate_issue" class="java.lang.Long"/>
	<field name="ready_to_issue" class="java.lang.Long"/>
	<field name="rejected_null_remarks" class="java.lang.Long"/>
	<field name="rejected_non_null_remarks" class="java.lang.Long"/>
	<field name="app_payment_pending" class="java.lang.Long"/>
