				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<text><![CDATA[नागपूर महानगरपालिका, नागपूर. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="6" y="98" width="24" height="35" uuid="20a05941-b8a5-4241-a31b-5b2261b53116">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(3)]]></text>
			</staticText>
			<staticText>
				<reportElement x="31" y="98" width="518" height="35" uuid="c29fc819-ff47-4b50-93e1-c16d7d76b392">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[परवानगी दिलेल्या सिमीत जमेपेक्षा जास्ती जागा वापरल्यास रु. २/- प्रती सौ.फुट प्रमाणे जागा वापर शुल्क ५००/- दंड वसुल कसायात येईल कार्यक्रम संपताच लगेच जागा रिकामी पूर्ववत करून द्यावी.]]></text>
			</staticText>
			<staticText>
				<reportElement x="6" y="134" width="24" height="34" uuid="a12eb9a5-07cb-46e8-b94f-f3aceccf0497">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(४)]]></text>
			</staticText>
			<staticText>
				<reportElement x="31" y="134" width="518" height="34" uuid="6f27f9ef-239b-4759-9940-306ad7e11132"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[कार्यक्रमा संबंधात नागरिकातर्फे किंवा इतर कोणतीही तक्रार प्राप्त झाल्यास देण्यात आलेले नाहरका त्वरीत रद्द करण्यात येईल.]]></text>
			</staticText>
			<staticText>
				<reportElement x="31" y="170" width="518" height="34" uuid="46f0fe30-efb9-425e-ba17-3db63cac9bba"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[शेड/मडप/स्वागतद्वार उभारण्याकरीता डांबर/सिमेंट रस्त्यावर तसेच फुटपाथवर खड्डे करण्यात येणार नाही जर असे आढळल्यास निर्धारित दडाची रक्कम कार्यालयात जमा करावी लागेल .]]></text>
			</staticText>
			<staticText>
				<reportElement x="6" y="170" width="24" height="34" uuid="6013fd6d-33ec-4541-9f9e-201396b9e9d5">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(५)]]></text>
			</staticText>
			<staticText>
				<reportElement x="31" y="207" width="518" height="18" uuid="81b5f871-22e3-43da-8a96-c26128c6f36c">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[सदर शेड/मंडप / स्वागतद्वारामुळे अपवात अगर धोका झाल्यास त्यास मनपा जबाबदार राहणार नाही]]></text>
			</staticText>
			<staticText>
				<reportElement x="7" y="207" width="24" height="18" uuid="75df05c2-36b3-43c9-a235-cae357ed0713"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(६) ]]></text>
			</staticText>
			<staticText>
				<reportElement x="31" y="227" width="518" height="18" uuid="41ea0924-7071-4c1c-a5b5-8aa28f35cf7c"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[कार्यक्रमास लागणारे विद्युत जोडणी अधिकृत करावी.]]></text>
			</staticText>
			<staticText>
				<reportElement x="6" y="227" width="24" height="18" uuid="874c732f-bbbe-4744-b1c1-65f48bf61ec6">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(७)]]></text>
			</staticText>
			<staticText>
				<reportElement x="31" y="247" width="518" height="50" uuid="5c4148ed-f121-49c3-a6c0-29af38b10620"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[कोणताही कार्यक्रम घेण्याकरीता वाहतुकीस अडचण निर्माण होणार नाही, रस्ते बंद करता येणा- नाही व नागरिकांना त्रास होणार नाही, याची दक्षता घेण्यांत यावी व पोलीस खात्याकडून मनोरंजन कार्यक्रम घेण्यापुर्वी रितसर परवानगी घेतल्याशिवाय कोणताही कार्यक्रम घेण्यात येऊ नये.]]></text>
			</staticText>
			<staticText>
				<reportElement x="31" y="300" width="518" height="34" uuid="8442a840-e9ca-42d2-b4d4-7a275c0c8d92">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[नमूद केलेल्या ठिकाणी कार्यक्रमादरम्यान झेडा, पुतळा किवा मुर्ती स्थापन करता येणार नाही.]]></text>
			</staticText>
			<staticText>
				<reportElement x="6" y="247" width="24" height="50" uuid="cab5a281-8a55-4227-b312-bb6a11fd0dd3">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(८)]]></text>
			</staticText>
			<staticText>
				<reportElement x="31" y="336" width="518" height="20" uuid="4a70057e-ea57-4190-a8f6-98bdb37e7bed"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[रस्त्यावर तसेच फुटपाथवर सामान ठेवता किवा विक्री करता येणार नाही. परवानगी दिलेल कार्यक्रमादरम्यान कचरा करण्यात येऊ नये]]></text>
			</staticText>
			<staticText>
				<reportElement x="6" y="300" width="24" height="34" uuid="d610d5ba-5d8d-43d8-bf24-c46aa6696eba">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(९) ]]></text>
			</staticText>
			<staticText>
				<reportElement x="6" y="42" width="24" height="34" uuid="0359d57b-ff1a-4679-a6f3-aa852e057d59"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(१)]]></text>
			</staticText>
			<staticText>
				<reportElement x="31" y="42" width="518" height="34" uuid="235bfbff-04a8-4681-b6f4-b7a00618cc63"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[पोलीस खान्याकडून सदर कार्यक्रमास  (सभा, धार्मिक  व सामाजिक कार्यक्रम व इतर कार्यक्रम)परवानगी प्राप्त होईल अशी धारणा आहे]]></text>
			</staticText>
			<staticText>
				<reportElement x="31" y="78" width="518" height="18" uuid="6b15b070-9778-4041-94a4-d7f574c5c05f"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[वाहतूक शाखा, उत्तर नागपूर याच्याकडून “ नाहरकत प्रमाणपत्र “ प्राप्त झालेले आहे.]]></text>
			</staticText>
			<staticText>
				<reportElement x="6" y="78" width="24" height="18" uuid="a248ef8d-4a9e-444b-ac38-2d8de3b6c48f">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(२)]]></text>
			</staticText>
			<staticText>
				<reportElement x="6" y="336" width="24" height="20" uuid="7da25172-6ea9-46dd-b8f0-77882a4bcfe9">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(१०) ]]></text>
			</staticText>
			<staticText>
				<reportElement x="32" y="359" width="518" height="18" uuid="e5a5c1e8-4b3a-40e3-91eb-25b70f3ba24c">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[महाराष्ट्र विद्रुपीकरण कायकाने उल्लंघन होणार नाही, याची जवाबदारी उमेदवाराची/ अर्जदाराची राहील .]]></text>
			</staticText>
			<staticText>
				<reportElement x="7" y="359" width="24" height="18" uuid="de965c4d-68c1-4a5b-818d-a119a72b1a80">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(११)]]></text>
			</staticText>
			<staticText>
				<reportElement x="32" y="380" width="518" height="50" uuid="29009930-49e9-4cbb-916c-274a1d4be016"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[कार्यक्रमादरम्यान, स्थळी कोणत्याही राजकीय स्वरूपाचे बॅनर्स, पोस्टर्स, होडींग, कटआऊट इत्यादी लावण्यात येऊ नये याबाबत जाहियत विभागाची स्वतंत्र परवानगी घ्यावे, तसेच आचारसहितेचे उल्लंघन झाल्यास अर्जदार, उमेदवार, सस्था कार्यवाहीस पात्र राहील]]></text>
			</staticText>
			<staticText>
				<reportElement x="8" y="380" width="24" height="50" uuid="7094647d-1c0b-40f0-9d88-b8983d7dfc14"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(१२) ]]></text>
			</staticText>
			<staticText>
				<reportElement x="32" y="432" width="518" height="18" uuid="6aa9688e-0bb2-4045-ab73-ec10522f3636"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[मडपाया साईज परवानगी मागीतल्याप्रमाणे असावा]]></text>
			</staticText>
			<staticText>
				<reportElement x="7" y="432" width="24" height="18" uuid="05d19e18-0399-478a-bef7-4951787d0f13">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(१३)]]></text>
			</staticText>
			<staticText>
				<reportElement x="32" y="452" width="518" height="18" uuid="b209bad4-0b1c-4003-8b4e-f0067dc6f5e0"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[अनधिकृत बॅनर/होडींग्ज लावण्यात येवू नये.]]></text>
			</staticText>
			<staticText>
				<reportElement x="32" y="472" width="518" height="34" uuid="b51de815-1973-464d-8bce-1a924d6af612">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[मा. आयुक्त, म.न.पा. नागपूर यांचे दि. ३०/१२/२०२१ चे आदेशान्वये साथरोग प्रतिबंधक कायदा १८९७, आपत्ती व्यवस्थापन अधिनियम २००५ तसेच 'भारतीय दंड संहिता १८६० वे अधिन राहुन कार्य करावे.]]></text>
			</staticText>
			<staticText>
				<reportElement x="7" y="452" width="24" height="18" uuid="0b7271af-eb9c-4f17-b9f8-cd0013e34be1">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(१४)]]></text>
			</staticText>
			<staticText>
				<reportElement x="32" y="508" width="518" height="20" uuid="f3ecf8ef-9f07-4e69-b43c-97e948498343"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[महाराष्ट्र शासन अधिसूचना, दिनांक ८ मे २०१५ चे तंतोतंत पालन करण्यात यावे]]></text>
			</staticText>
			<staticText>
				<reportElement x="7" y="472" width="24" height="34" uuid="039ce66c-4c16-4e77-bf0f-104f660f9cf8">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(१५) ]]></text>
			</staticText>
			<staticText>
				<reportElement x="7" y="508" width="24" height="20" uuid="0db6457a-8e84-4929-8649-67b6e10b309f">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(१६) ]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="20" width="310" height="19" uuid="92a24df9-6fbf-4910-a27b-731b4188d3ae"/>
				<textElement>
					<font size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[ना हरकत प्रमाणपत्र निर्गमित करण्यात येत आहे. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="-1" width="310" height="20" uuid="1c8155a4-fea6-4b07-a852-cbc2bc53d664"/>
				<textElement>
					<font size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[खालील अटी व शर्तीवर व  अर्जदाराने दिलेल्या  हमीपत्रान्वये  या कार्यालयातर्फे ]]></text>
			</staticText>
		</band>
	</detail>
</jasperReport>
