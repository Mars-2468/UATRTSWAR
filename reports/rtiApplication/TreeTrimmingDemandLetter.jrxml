	<detail>
		<band height="532" splitType="Stretch">
			<textField>
				<reportElement x="21" y="41" width="525" height="349" uuid="ecc2f92c-2654-4223-bcbf-476a2aefe3cb"/>
				<textElement>
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["प्रति,  "+"\n"+$F{full_name} +"\n" +$F{address}+"\n"+"\n"+"विषय :-   वृक्षांच्या फांद्या छाटण्याबाबत "+"\n"+"संदर्भ :- "+$F{full_name}+" यांचा वृक्षांच्या फांद्या छाटण्यासाठी अर्ज,  दिनांक: "+$F{to_char}+" कार्यालयास प्राप्त झाला."+"\n"+"\n"+"               मा. उपायुक्त (उद्यान) तथा वृक्ष अधिकारी, मनपा, नागपूर यांच्या दिनांक "+$F{to_char}+" च्या मंजुरी अन्वये, येथील  एकूण "+$F{actualnumberoftreetrimming}+" वृक्षांच्या फांद्या छाटण्याकरीता अर्जदाराकडून प्रशासकिय शुल्क रु. "+$F{totalfeeswithgst}+"/- " +" रक्कम स्विकारण्याच्या अटीवर मंजुरी प्राप्त झाली आहे. " +"\n"+"                तेव्हा सदर रक्कम या कार्यालयात सात दिवसाचे आत जमा करावे. त्यानंतरच आपल्याला वृक्षांच्या फांद्या छाटण्यासाठी परवानगी देण्यात येईल. अन्यथा वृक्ष किंवा वृक्षांची फांदी पडल्यास होणाऱ्या जीव व वित्तहानीची सर्वस्व जवाबदारी आपली राहील."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="377" y="489" width="150" height="20" uuid="e80b738f-bab6-469a-ac8e-5e0da56b013d"/>
