<!-- 2026-11-20T13:06:27 -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FireTransactionReport" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e4494181-4f61-4761-8869-50b9407f10a5">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="NMC_RTS_DB"/>
	<parameter name="fromDate" class="java.util.Date"/>
	<parameter name="toDate" class="java.util.Date"/>
	<parameter name="showTitle" class="java.lang.Boolean"/>
	<parameter name="status" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT x.*
FROM (
    SELECT DISTINCT ON (COALESCE(NULLIF(TRIM(t.easepayid), ''), CAST(t.easebuzzwebhookid AS varchar)))
        CAST(a.rti_application_number AS varchar)             AS rti_application_number,
        t.easepayid                                           AS easebuzz_id,
        CAST(NULLIF(TRIM(t.amount), '') AS numeric(14,2))     AS amount,
        t.status                                              AS transaction_status,
        t.txnid                                               AS transaction_ref_number,
        t.bank_ref_num                                        AS bank_ref_number,
        t.firstname                                           AS customer_name,
        t.phone                                               AS customer_phone,
        CAST(NULLIF(TRIM(t.addedon), '') AS timestamp)        AS transaction_date,
        t.txnid                                               AS merchant_transaction_id,
        t.payment_source                                      AS submerchant_name,
        t.upi_va                                              AS customer_upi_ifsc_code,
        t.cardnum                                             AS customer_upi_account_number,
        t.easepayid                                           AS customer_upi_ref_id,
        CAST(NULLIF(TRIM(t.addedon), '') AS timestamp)        AS sort_time
    FROM egovrti.easebuzzwebhook t
    JOIN egovrti.collection_buffer cb
          ON TRIM(CAST(cb.uniq_pg_id AS varchar)) = TRIM(t.txnid)
    JOIN egovrti.rti_application a
          ON a.rti_application_id = cb.rti_application_id
    WHERE a.rti_service_id = 69
      AND CAST(NULLIF(TRIM(t.addedon), '') AS timestamp) >= CAST($P{fromDate} AS timestamp)
      AND CAST(NULLIF(TRIM(t.addedon), '') AS timestamp) <  CAST($P{toDate} AS timestamp) + INTERVAL '1 day'
    ORDER BY COALESCE(NULLIF(TRIM(t.easepayid), ''), CAST(t.easebuzzwebhookid AS varchar)),
             t.easebuzzwebhookid DESC
) x
WHERE ( UPPER(COALESCE(NULLIF(TRIM(CAST($P{status} AS varchar)), ''), 'ALL')) = 'ALL'
     OR ( UPPER(TRIM(CAST($P{status} AS varchar))) = 'SUCCESS'
          AND LOWER(TRIM(x.transaction_status)) = 'success' )
     OR ( UPPER(TRIM(CAST($P{status} AS varchar))) = 'FAILURE'
          AND LOWER(TRIM(x.transaction_status)) IN ('failure', 'failed', 'usercancelled', 'dropped', 'bounced') )
)
ORDER BY x.sort_time ASC]]>
	</queryString>
