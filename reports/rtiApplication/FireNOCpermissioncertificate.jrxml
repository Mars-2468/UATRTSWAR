					<textFieldExpression><![CDATA["गणेशोत्सव " +
Integer.toString(java.util.Calendar.getInstance().get(java.util.Calendar.YEAR))
    .replace('0','०').replace('1','१').replace('2','२').replace('3','३')
    .replace('4','४').replace('5','५').replace('6','६').replace('7','७')
    .replace('8','८').replace('9','९')
+ "-" +
String.format("%02d", (java.util.Calendar.getInstance().get(java.util.Calendar.YEAR)+1)%100)
    .replace('0','०').replace('1','१').replace('2','२').replace('3','३')
    .replace('4','४').replace('5','५').replace('6','६').replace('7','७')
    .replace('8','८').replace('9','९')
+" संबंधाने ना हरकत प्रमाणपत्र देणे बाबत."]]></textFieldExpression>
