					</textElement>
					<text><![CDATA[सार्वजनिक गणेशोत्सव  मंडप नाहरकत प्रमाणपत्र]]></text>
				</staticText>
			</frame>
			<image>
				<reportElement x="255" y="0" width="51" height="50" uuid="4d373f4a-0f7a-4b31-aa62-55e831f2987b"/>
				<imageExpression><![CDATA["../../images/amclogodash.png"]]></imageExpression>
			</image>
			<staticText>
				<reportElement x="3" y="420" width="549" height="57" uuid="ffbf6e34-a32a-482f-9d87-f5a1cb42be85"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[ अर्जात दिलेल्या माहितीप्रमाणे आपले नियोजित तात्पुरते मंडपाचे क्षेत्रफळ लक्षात घेता महाराष्ट्र आग प्रतिबंधक व जिवसंरक्षक उपाययोजना अधिनियम २००६ व सुधारणा अधिनियम २०२३ तथा भारतीय राष्ट्रीय इमारत संहिता २०१६ च्या कलम ३.२.५ च्या तरतुदीनुसार तात्पुरते मंडपाच्या उभारणीकरीता किमान आग प्रतिबंधक व जिवसंरक्षक उपाययोजना करणे बंधनकारक आहे.]]></text>
			</staticText>
			<frame>
				<reportElement x="-3" y="490" width="560" height="250" uuid="efbeb058-2e4a-4202-ba62-f721c057322c"/>
				<staticText>
					<reportElement x="31" y="8" width="526" height="40" uuid="9b2b252a-ad15-4799-8000-0365bb460c6d"/>
					<textElement textAlignment="Left">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[त्या अनुषंगाने उभारण्यात येणारे तात्पुरते मंडप करीता आग प्रतिबंधक व जिवसुरक्षेच्या दुष्टीने खालीलप्रमाणे उपाययोजना करण्यात यावे.]]></text>
				</staticText>
				<staticText>
					<reportElement x="5" y="49" width="25" height="20" uuid="80a7cb12-00ed-4df3-8426-be6516effa0a"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS"/>
					</textElement>
					<text><![CDATA[१) ]]></text>
				</staticText>
				<staticText>
					<reportElement x="31" y="49" width="526" height="20" uuid="3b5346f2-f655-480e-a2e4-a4708ebf0fc0"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[मंडपात २ नग  ABC Type Fire Extinguisher ची व्यवस्था करण्यात यावी .]]></text>
				</staticText>
				<staticText>
					<reportElement x="32" y="69" width="525" height="20" uuid="113e360d-eca9-46dd-b473-e0ca7378f40a"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[१ नग २०० लिटर पाण्याचा साठा ड्रमच्या स्वरुपात ९ लिटर क्षमतेच्या बादलीसह ठेवण्यात यावा.]]></text>
				</staticText>
				<staticText>
					<reportElement x="4" y="69" width="26" height="20" uuid="94530e70-d5d1-42e7-9cee-3b40252c0d31"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[२) ]]></text>
				</staticText>
				<staticText>
					<reportElement x="3" y="89" width="28" height="20" uuid="1c03b898-7ab4-43a8-ba80-e95fbbff96e6"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[३)]]></text>
				</staticText>
				<staticText>
					<reportElement x="31" y="89" width="527" height="20" uuid="d1842f80-4639-4f66-8b5d-ad8cf2d74dc6"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[जाण्या-येण्याकरीता असलेला मार्ग तथा परिसरातील सर्व रस्त्यांना मोकळे ठेवण्यात यावे]]></text>
				</staticText>
				<staticText>
					<reportElement x="3" y="114" width="29" height="20" uuid="e55d3e18-3486-4b71-8061-6e1762325cb3"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[४) ]]></text>
				</staticText>
				<staticText>
					<reportElement x="30" y="109" width="530" height="40" uuid="609c4f31-b73d-4294-b987-deeae357b0d2"/>
					<textElement textAlignment="Justified">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[गॅसबत्ती, केरोसीनवर चालणारे दिवे, मेणबत्ती, शेगडी, गॅस सिलेंडर, ज्वलनशील पदार्थ तथा स्फोटके, लाकडे, सुखे गवत इत्यादीचा साठा परिसरात ठेवण्यात येवू नये.]]></text>
				</staticText>
				<staticText>
					<reportElement x="3" y="159" width="25" height="20" uuid="4ec72a52-c51e-48f1-8988-32d22f040631"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[५)]]></text>
				</staticText>
				<staticText>
					<reportElement x="30" y="149" width="530" height="40" uuid="7f138c99-0d0b-40e0-aeeb-0c164b3a46f4"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[सर्व विद्युत उपकरणे हे आय.एस.एय मार्क चे व योग्य क्षमतेचे असावेत तसेच स्वयंचलीत विद्युत खंडित यंत्रणा (ELCB,MCB) उपाययोजना करण्यात यावी.]]></text>
				</staticText>
				<staticText>
					<reportElement x="30" y="189" width="529" height="40" uuid="f162b591-2cc4-4d94-bc1f-9b1e1ef04301"/>
					<textElement textAlignment="Justified">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[वरीलप्रमाणे आग प्रतिबंधक व जिवसंरक्षक उपाययोजना करण्याच्या अटीवर सशर्त आग संरक्षक मान्यता प्रमाणपत्र निर्गमित करण्यात येत आहे.]]></text>
				</staticText>
			</frame>
