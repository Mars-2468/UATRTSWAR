	<subDataset name="MeasuresDataset" uuid="41f8a386-0121-457e-a482-d9ea15bff868">
		<parameter name="rtiapplrefid" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT fcm.sr_no AS measure_sr, fcm.measure_name AS measure_label, fcm.status AS measure_status, fcm.quantity AS measure_qty, fcm.location AS measure_location FROM egovrti.fire_compliance_measure fcm WHERE fcm.fire_compliance_certificate_id = (SELECT fcc2.fire_compliance_certificate_id FROM egovrti.fire_compliance_certificate fcc2 WHERE fcc2.rti_ref_id = $P{rtiapplrefid} LIMIT 1) ORDER BY fcm.sr_no]]>
		</queryString>
		<field name="measure_sr" class="java.lang.Integer"/>
		<field name="measure_label" class="java.lang.String"/>
		<field name="measure_status" class="java.lang.String"/>
		<field name="measure_qty" class="java.lang.String"/>
		<field name="measure_location" class="java.lang.String"/>
	</subDataset>
	<subDataset name="IntStairDataset" uuid="5a5eab44-b930-4420-9cc5-99b968ecad41">
		<parameter name="rtiapplrefid" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT row_number() OVER () AS sr_no, t.staircase_no, t.staircase_width FROM (SELECT unnest(string_to_array(fcc2.noofinternalstaircase, ',')) AS staircase_no, unnest(string_to_array(fcc2.widthinternalstaircase, ',')) AS staircase_width FROM egovrti.fire_compliance_certificate fcc2 WHERE fcc2.rti_ref_id = $P{rtiapplrefid} LIMIT 1) t]]>
		</queryString>
		<field name="sr_no" class="java.lang.Long"/>
		<field name="staircase_no" class="java.lang.String"/>
		<field name="staircase_width" class="java.lang.String"/>
	</subDataset>
	<subDataset name="ExtStairDataset" uuid="0d0a49af-96e2-4c49-9d82-55c3a2989ec0">
		<parameter name="rtiapplrefid" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT row_number() OVER () AS sr_no, t.staircase_no, t.staircase_width FROM (SELECT unnest(string_to_array(fcc2.noofexternalstaircase, ',')) AS staircase_no, unnest(string_to_array(fcc2.widthexternalstaircase, ',')) AS staircase_width FROM egovrti.fire_compliance_certificate fcc2 WHERE fcc2.rti_ref_id = $P{rtiapplrefid} LIMIT 1) t]]>
		</queryString>
		<field name="sr_no" class="java.lang.Long"/>
		<field name="staircase_no" class="java.lang.String"/>
		<field name="staircase_width" class="java.lang.String"/>
	</subDataset>
	<subDataset name="LiftDataset" uuid="c2f68b2b-9fdb-44a6-bde6-31c756be2c66">
		<parameter name="rtiapplrefid" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT row_number() OVER () AS sr_no, t.lift_type FROM (SELECT unnest(string_to_array(fcc2.noofliftprovided, ',')) AS lift_type FROM egovrti.fire_compliance_certificate fcc2 WHERE fcc2.rti_ref_id = $P{rtiapplrefid} LIMIT 1) t]]>
		</queryString>
		<field name="sr_no" class="java.lang.Long"/>
		<field name="lift_type" class="java.lang.String"/>
	</subDataset>
	<parameter name="rtiapplrefid" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{rtiapplrefid}]]></defaultValueExpression>
	</parameter>
	<parameter name="ctx" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{ctx}]]></defaultValueExpression>
	</parameter>
	<parameter name="serverHost" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{serverHost}]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    fcc.*,
    ra.rti_application_number,
    ra.created_date,
    SPLIT_PART(ra.pdf_upload_from_portal,',',1) AS doc1_url,
    SPLIT_PART(ra.pdf_upload_from_portal,',',2) AS doc2_url,
    SPLIT_PART(ra.pdf_upload_from_portal,',',3) AS doc3_url,
    SPLIT_PART(ra.pdf_upload_from_portal,',',4) AS doc4_url,
    SPLIT_PART(ra.pdf_upload_from_portal,',',5) AS doc5_url,
    SPLIT_PART(ra.pdf_upload_from_portal,',',6) AS doc6_url,
    SPLIT_PART(ra.pdf_upload_from_portal,',',7) AS doc7_url
FROM egovrti.fire_compliance_certificate fcc
JOIN egovrti.rti_application ra ON fcc.rti_ref_id = ra.rti_application_id
WHERE fcc.rti_ref_id = $P{rtiapplrefid}
LIMIT 1]]>
	</queryString>
