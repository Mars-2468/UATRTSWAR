<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DogLicenseMain" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c68e7a2f-db0b-468e-b4f9-13fd4d4d43e8">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="EGOV_NMC_UAT"/>
	<subDataset name="Empty Dataset1" uuid="49cb1a45-7f0e-4130-b219-48fe4f40e9ad"/>
	<parameter name="rtiapplrefid" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    dl.first_name, 
    dl.dog_license_id, 
    dl.middle_name, 
    dl.last_name, 
    dl.correspondence_address AS address, 
    dd.dog_sub_type AS sub_type,
    dd.dog_tail_length ,
    dd.dog_img_files as d_image,
    dd.dog_details_id as d_id,

      to_char(TO_DATE(dd.first_dose_date,'yyyy-mm-dd'),'dd-mm-yyyy') as first_dose_date,
            to_char(TO_DATE(dd.second_dose_date,'yyyy-mm-dd'),'dd-mm-yyyy') as second_dose_date,

    
      CASE
        WHEN dd.dog_type = 'IndianDog' THEN 'Indian Dog'
        WHEN dd.dog_type = 'BreedDog' THEN 'Breed Dog'
    END AS dog_type,
    CASE 
        WHEN dl.zone_no = 1 THEN 'Zone No.1 - Laxmi Nagar'
        WHEN dl.zone_no = 2 THEN 'Zone No.2 - Dharmpeth'
        WHEN dl.zone_no = 3 THEN 'Zone No.3 - Hanuman Nagar'
        WHEN dl.zone_no = 4 THEN 'Zone No.4 - Dhantoli'
        WHEN dl.zone_no = 5 THEN 'Zone No.5 - Nehru Nagar'
        WHEN dl.zone_no = 6 THEN 'Zone No.6 - Gandhibag'
        WHEN dl.zone_no = 7 THEN 'Zone No.7 - Satranjipura'
        WHEN dl.zone_no = 8 THEN 'Zone No.8 - Lakadganj'
        WHEN dl.zone_no = 9 THEN 'Zone No.9 - Aashi Nagar'
        WHEN dl.zone_no = 10 THEN 'Zone No.10 - Mangalwari'
    END AS zone_no,
    dd.* 
FROM  
    egovrti.doglicence dl
    JOIN egovrti.dog_details dd 
    ON dl.dog_license_id = dd.dog_license_id  
WHERE  
    dl.rti_ref_id   =  $P{rtiapplrefid};]]>
	</queryString>
