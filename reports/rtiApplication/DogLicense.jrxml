			<staticText>
				<reportElement x="30" y="206" width="530" height="18" uuid="c8b6ee7e-e456-4ca5-ba05-8e9cec52d596">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement>
					<font size="12"/>
				</textElement>
				<text><![CDATA[If the dogs are in a public place, they must be on a leash and properly supervised and controlled.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="206" width="30" height="18" uuid="6ffa11cb-83f5-4037-bf66-a84cd77ab31f">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[•]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="224" width="30" height="18" uuid="30d9dc65-6b67-4eed-8caa-b56ae36a4f93">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[•]]></text>
			</staticText>
			<staticText>
				<reportElement x="30" y="224" width="530" height="18" uuid="3e67bd82-bd13-4340-ab83-6d26660a1abf">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement>
					<font size="12"/>
				</textElement>
				<text><![CDATA[The license is renewed annually.]]></text>
			</staticText>
			<staticText>
				<reportElement x="30" y="242" width="530" height="18" uuid="662f10b1-e0d2-454e-a675-2e61cbce560c">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement>
					<font size="12"/>
				</textElement>
				<text><![CDATA[NMC must be informed of any change of ownership of the dog.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="242" width="30" height="18" uuid="209718ea-3a81-42f3-ac19-87425dbc6ce9">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[•]]></text>
			</staticText>
			<staticText>
				<reportElement x="30" y="260" width="530" height="18" uuid="fa7405a9-733b-48cc-b140-20357814bd13">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement>
					<font size="12"/>
				</textElement>
				<text><![CDATA[NMC must be informed of any change of address where the dog is kept.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="260" width="30" height="18" uuid="228144ce-a86b-46ce-8577-c62c0ef63888">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[•]]></text>
			</staticText>
			<staticText>
				<reportElement x="30" y="278" width="530" height="18" uuid="07b084c9-063d-423c-94af-3a64d648d074">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement>
					<font size="12"/>
				</textElement>
				<text><![CDATA[NMC must be informed if the dog is lost or has died.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="278" width="30" height="18" uuid="81697ed3-a4dc-413d-a8d7-6e4c3508dc5a">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[•]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="296" width="30" height="18" uuid="9af3fd1a-2909-4ccf-8eba-2fe5c8b80ee9">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[•]]></text>
			</staticText>
			<staticText>
				<reportElement x="30" y="296" width="530" height="31" uuid="8ca0a351-540f-4ace-a47c-dd09a8151235">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement>
					<font size="12"/>
				</textElement>
				<text><![CDATA[You are allowed by NMC to keep the dog in the registered premises as stated in your license application.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="327" width="30" height="18" uuid="6c97062c-bc07-4001-9628-19581d25c49d">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[•]]></text>
			</staticText>
			<staticText>
				<reportElement x="30" y="327" width="530" height="31" uuid="dd31ce5d-0794-419f-b967-c8959e1ebaee">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement>
					<font size="12"/>
				</textElement>
				<text><![CDATA[The dog license is solely for licensing purposes and does not approve you to keep the dog at the stated premises.]]></text>
			</staticText>
			<staticText>
				<reportElement x="30" y="358" width="530" height="18" uuid="6decfd55-5bb4-4093-a210-941626dd0343">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement>
					<font size="12"/>
				</textElement>
				<text><![CDATA[Owners found breaching the rules or license conditions may be fined for the offense.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="358" width="30" height="18" uuid="f0316052-b488-410c-afda-89ff485977c2">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[•]]></text>
			</staticText>
			<staticText>
				<reportElement x="30" y="376" width="530" height="31" uuid="ae105472-f016-463c-857d-f6693761f791">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement>
					<font size="12"/>
				</textElement>
				<text><![CDATA[To avoid a higher penalty in court and unnecessary inconvenience, please settle your compassion sum promptly.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="376" width="30" height="18" uuid="837822cb-0c4b-41f0-bde1-25993bb61ad8">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[•]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="407" width="30" height="18" uuid="da57c744-6e2a-489d-a85f-d4baa5c99663">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[•]]></text>
			</staticText>
			<staticText>
				<reportElement x="30" y="407" width="530" height="18" uuid="6dda7811-f85e-4f6b-bc82-ef3804cf4c96">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement>
					<font size="12"/>
				</textElement>
				<text><![CDATA[A maximum of three dogs are allowed per private premises, including commercial premises.]]></text>
			</staticText>
			<staticText>
				<reportElement x="30" y="425" width="530" height="18" uuid="12fb75ef-f27d-499c-afbc-e61196f96d98">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement>
					<font size="12"/>
				</textElement>
				<text><![CDATA[Special permission must be obtained from NMC to keep more than three dogs.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="425" width="30" height="18" uuid="234e4f46-5c94-4a14-87c0-83f6a7189fb0">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[•]]></text>
			</staticText>
