	<queryString>
		<![CDATA[SELECT 
    mp.*, 
    ra.*, 
    mtp.*
FROM 
    egovrti.dog_details AS mp
JOIN 
    egovrti.doglicence AS mtp 
    ON mp.dog_license_id = mtp.dog_license_id
JOIN 
    egovrti.rti_application AS ra 
    ON mtp.rti_ref_id = ra.rti_application_id
WHERE 
    mtp.rti_ref_id =  $P{rtiapplrefid};]]>
	</queryString>
