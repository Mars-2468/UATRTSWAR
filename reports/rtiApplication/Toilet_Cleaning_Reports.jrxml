	<property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>
	<parameter name="FROM_DATE" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="TO_DATE" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="ZONE" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="WORKFLOW_STATUS" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{WORKFLOW_STATUS}]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    sc.cleaning_id,
    sc.zone_name,
    sc.zoneid,
    sc.currentDate AS cleaning_date,
    sc.block_no,
    sc.blockUnit,
    sc.latitude,
    sc.longitude,
    sc.latitude || ',' || sc.longitude AS google_coordinates,
    sc.encoded_files_path,
    sc.files_path,
    sc.workflowstatus,
    CASE 
        WHEN sc.workflowstatus = 0 THEN 'Under Review'
        WHEN sc.workflowstatus = 1 THEN 'Approved'
        WHEN sc.workflowstatus = 5 THEN 'Rejected'
        ELSE 'Unknown'
    END AS workflow_status_text,
    (string_to_array(TRIM(sc.files_path), ','))[1] AS file_url_1,
    (string_to_array(TRIM(sc.files_path), ','))[2] AS file_url_2
FROM 
    egovrti.toilet_cleaning sc
WHERE 
    TO_DATE(sc.currentDate, 'yyyy-mm-dd') 
        BETWEEN TO_DATE($P{FROM_DATE}, 'yyyy-mm-dd') 
        AND TO_DATE($P{TO_DATE}, 'yyyy-mm-dd')
    AND (
        $P{ZONE} = 'ALL' 
        OR sc.zoneid = $P{ZONE}
    )
    AND (
        $P{WORKFLOW_STATUS} IS NULL 
        OR TRIM($P{WORKFLOW_STATUS}) = '' 
        OR sc.workflowstatus = $P{WORKFLOW_STATUS}
    )
ORDER BY 
    sc.currentDate ASC;]]>
	</queryString>
