					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[हेरीटेज वृक्षांची एकूण संख्या]]></text>
			</staticText>
			<staticText>
				<reportElement x="22" y="409" width="106" height="40" uuid="56321f2f-8653-4513-8ba4-7619d81bf3a7"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[वृक्षांची संख्या]]></text>
			</staticText>
			<staticText>
				<reportElement x="22" y="519" width="525" height="101" uuid="9819cf25-bc41-411c-ae1d-a89699825c03"/>
				<textElement>
					<font fontName="Arial Unicode MS" size="12"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[अटी व शर्ती : 
१) वृक्ष काढत असताना सभोवतालचे तार कुंपण/झाडे/विद्युत तारा/टेलिफोन तारा व इतर मालमत्तेचे नुकसान 
    होणार नाही याची दक्षता घ्यावी व त्यातील वित्त अथवा इतर हानीस वृक्ष प्राधिकरण जबाबदार राहणार 
    नाही.
२) वृक्षतोड रविवारी करू नये.
३) सदर वृक्षतोड मनपा प्रतिनिधी समक्षच करावी.]]></text>
			</staticText>
