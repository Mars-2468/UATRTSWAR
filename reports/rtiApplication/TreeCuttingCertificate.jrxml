	<parameter name="rtiapplrefid" class="java.lang.String"/>
	<queryString>
		<![CDATA[select  tt.full_name,
tt.rti_appl_ref_no ,
tt.address,
tt.resone_tree_cuting ,
tt.wardno,
tt.treetype ,
tt.number_of_tree_cuting,
tt.street_name,
tt.totalnonheritage,
tt.totalheritage,
tt.actualnumberoftreetrimming,
tt.tree_address
from egovrti.tree_cuting tt
where tt.rti_ref_id  = $P{rtiapplrefid};]]>
	</queryString>
