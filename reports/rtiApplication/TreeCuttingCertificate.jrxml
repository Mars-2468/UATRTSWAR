				</textElement>
				<text><![CDATA[वृक्ष तोड परवानगी]]></text>
			</staticText>
			<frame>
				<reportElement x="14" y="210" width="519" height="190" uuid="fefaa77c-78b4-4882-aa8c-b0f54895152d"/>
				<textField isBlankWhenNull="true">
					<reportElement x="13" y="4" width="504" height="186" uuid="393e7e27-8bdc-43b3-a257-6ec0f8c6be66"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<textFieldExpression><![CDATA["प्रति,"+"\n"+$F{full_name}+","+"\n"+$F{address}+"."+"\n"+"\n"+"विषय : वृक्ष तोड परवानगी बाबत."+"\n"+"संदर्भ :- "+$F{full_name}+" यांचा वृक्ष तोडणी अर्ज."+"\n"+"\n"+"       उपरोक्त विषयांकित प्रकरणीआपला संदर्भीय अर्ज या कार्यालयास प्राप्त झाला आहे. आपणास खालीलअटी शर्तीसआधीन राहून " + $F{tree_address}+ " येथील बांधकामात बाधित होणारे / वाळलेले /घरास धोका निर्माण करणारे विविध प्रजातीचे वृक्ष तोडण्याची परवानगी देण्यात येत आहे.  "]]></textFieldExpression>
