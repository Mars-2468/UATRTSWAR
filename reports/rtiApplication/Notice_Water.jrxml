				</textElement>
				<textFieldExpression><![CDATA[$F{address}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="21" y="64" width="144" height="20" uuid="ecc2f92c-2654-4223-bcbf-476a2aefe3cb"/>
				<textElement>
					<font fontName="Arial Unicode MS"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{full_name}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="21" y="35" width="81" height="21" uuid="777bf7c4-6285-41b9-95cf-7e7a98bed536"/>
				<textElement>
					<font fontName="Arial Unicode MS"/>
				</textElement>
				<text><![CDATA[प्रति,  ]]></text>
			</staticText>
			<textField>
				<reportElement x="21" y="130" width="472" height="26" uuid="fb1bf870-c139-4bbc-90bc-857e06b27d5f"/>
