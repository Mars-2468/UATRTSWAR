	<detail>
		<band height="426" splitType="Stretch">
			<textField>
				<reportElement x="25" y="185" width="500" height="100" uuid="26741959-76de-486d-9964-56a897695086"/>
				<textElement>
					<font fontName="Arial Unicode MS"/>
				</textElement>
				<textFieldExpression><![CDATA["              उपरोक्त संदर्भांकित विषयाअन्वये कळविण्यात येते कि,वृक्ष तोडणी करण्याची  परवानगी मिळण्याकरिता कार्यालयास अर्ज सादर केलेला आहे. "+"\n"+"            या प्रकरणी आपले “ना हरकत प्रमाणपत्र” आवश्यक आहे. करिता आपली कुठलीही  हरकत नसल्यास तसे “ना हरकत  प्रमाणपत्र” या कार्यालयास सादर करावे. जेणेकरून याप्रकरणी पुढील कार्यवाही करणे योग्य राहील."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="21" y="86" width="144" height="20" uuid="f59a18b8-0d04-41e7-8d31-ee16d9c02482"/>
				<textElement>
