	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="egvNmc"/>
	<parameter name="FROM_DATE" class="java.lang.String"/>
	<parameter name="TO_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    ra.department,
    ra.rti_service_id,
    ra.subject,
    COUNT(CASE WHEN ra.workflow_status NOT IN (9) THEN 1 END) AS total_applications,
    COUNT(CASE WHEN ra.workflow_status NOT IN (1, 0, 2, 3, 9) THEN 1 END) AS rejected,
    COUNT(CASE WHEN ra.workflow_status NOT IN (1, 5, 2, 3, 9) THEN 1 END) AS process,
    COUNT(CASE WHEN ra.workflow_status NOT IN (0, 5, 2, 3, 9) THEN 1 END) AS certificate_issue,
    COUNT(CASE WHEN ra.workflow_status NOT IN (1, 5, 0, 3, 9) THEN 1 END) AS ready_to_issue,
    COUNT(CASE WHEN ra.workflow_status NOT IN (1, 5, 2, 0, 9) THEN 1 END) AS app_payment_pending
FROM 
    egovrti.rti_application ra
WHERE 
    CAST(ra.registration_date AS DATE) BETWEEN TO_DATE($P{FROM_DATE}, 'dd/mm/yyyy') AND TO_DATE($P{TO_DATE}, 'dd/mm/yyyy')
GROUP BY 
    ra.department, ra.rti_service_id, ra.subject
ORDER BY 
    ra.department;]]>
	</queryString>
	<field name="department" class="java.lang.String"/>
	<field name="rti_service_id" class="java.lang.Integer"/>
	<field name="subject" class="java.lang.String"/>
	<field name="total_applications" class="java.lang.Long"/>
	<field name="rejected" class="java.lang.Long"/>
	<field name="process" class="java.lang.Long"/>
	<field name="certificate_issue" class="java.lang.Long"/>
