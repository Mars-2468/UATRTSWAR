<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BOT" pageWidth="980" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="940" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d801ecdc-ec91-42ea-9dde-6b3a72aefc71">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="egov_nmc"/>
	<parameter name="zone" class="java.lang.String"/>
	<parameter name="FROM_DATE" class="java.lang.String"/>
	<parameter name="TO_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    COUNT(case when tc.ws in (0,1,2,3,5) then 1 end) as total_applications,
    COUNT(CASE WHEN tc.ws = 0 AND tc.ws NOT IN (1, 5, 2, 3) THEN 1 END) AS applicationInProcess,
    COUNT(CASE WHEN tc.ws = 1 AND tc.ws NOT IN (0, 5, 2, 3) THEN 1 END) AS certificateIssue,
    COUNT(CASE WHEN tc.ws = 5 AND tc.ws NOT IN (1, 0, 2, 3) THEN 1 END) AS appRejected,
    COUNT(CASE WHEN tc.ws = 2 AND tc.ws NOT IN (1, 5, 0, 3) THEN 1 END) AS readyToIssue,
    COUNT(CASE WHEN tc.ws = 3 AND tc.ws NOT IN (1, 5, 2, 0) THEN 1 END) AS appPayentpending,
    tc.subject,
    MAX(tc.zone) AS zn
FROM (
    SELECT
        ra.workflow_status AS ws,
        ra.subject,
        CASE
            WHEN ra."zone" = 1 THEN 'Zone No.1 - Laxmi Nagar (लक्ष्मी नगर)'
            WHEN ra."zone" = 2 THEN 'Zone No.2 - Dharmpeth (धरमपेठ)'
            WHEN ra."zone" = 3 THEN 'Zone No.3 - Hanuman Nagar (हनुमान नगर)'
            WHEN ra."zone" = 4 THEN 'Zone No.4 - Dhantoli (धंतोली)'
            WHEN ra."zone" = 5 THEN 'Zone No.5 - Nehru Nagar (नेहरू नगर)'
            WHEN ra."zone" = 6 THEN 'Zone No.6 - Gandhibag (गांधीबाग)'
            WHEN ra."zone" = 7 THEN 'Zone No.7 - Satranjipura (सतरंजीपुरा)'
            WHEN ra."zone" = 8 THEN 'Zone No.8 - Lakadganj (लकडगंज)'
            WHEN ra."zone" = 9 THEN 'Zone No.9 - Aashi Nagar (आशी नगर)'
            WHEN ra."zone" = 10 THEN 'Zone No.10 - Mangalwari (मंगळवारी)'
        END AS zone
    FROM
        egovrti.rti_application ra
    WHERE
         $P{zone} = ra."zone"
        AND ra.rti_application_number IS NOT NULL
        AND ra.rti_application_number != ''
        AND to_date(ra.created_date, 'dd/mm/yyyy hh24:mi:ss') BETWEEN to_date($P{FROM_DATE}, 'dd/mm/yyyy hh24:mi:ss') AND to_date($P{TO_DATE}, 'dd/mm/yyyy hh24:mi:ss')
) AS tc
GROUP BY tc.subject;]]>
	</queryString>
	<field name="total_applications" class="java.lang.Long"/>
	<field name="applicationinprocess" class="java.lang.Long"/>
	<field name="certificateissue" class="java.lang.Long"/>
	<field name="apprejected" class="java.lang.Long"/>
	<field name="readytoissue" class="java.lang.Long"/>
	<field name="apppayentpending" class="java.lang.Long"/>
	<field name="subject" class="java.lang.String"/>
	<field name="zn" class="java.lang.String"/>
	<variable name="total_app" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{total_applications}]]></variableExpression>
