	<parameter name="date" class="java.lang.String"/>
	<parameter name="zone" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    amount,
    misc_id,
    zone,
    department,
    purpose,
    receivedby,
    receivedfrom,
    COUNT(*) OVER () AS total_count
FROM 
    egovrti.misc_application
WHERE 
   	date = $P{date}   AND zone = $P{zone}
ORDER BY 
    date DESC]]>
	</queryString>
