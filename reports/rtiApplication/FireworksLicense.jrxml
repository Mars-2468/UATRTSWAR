<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FireworksLicense" pageWidth="595" pageHeight="1100" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="9100751b-1925-4afe-9691-c17722e9eacd">
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="rtiapplrefid" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    fc.rti_application_ref_id  ,
    TO_CHAR(TO_DATE(ra.registration_date, 'dd/mm/yyyy hh24:mi:ss'), 'dd/mm/yyyy') AS registration_date,
    ra.applicant_name,
    fc.name_of_professional ,
    fc.place_of_establishment ,
    TO_CHAR(TO_TIMESTAMP(fc.pavilion_start_date, 'yyyy-mm-dd'), 'dd/mm/yyyy') AS pavilion_start_date,
    TO_CHAR(TO_TIMESTAMP(fc.pavilion_end_date, 'yyyy-mm-dd'), 'dd/mm/yyyy') AS pavilion_end_date
FROM
    egovrti.fire_crackers_shop_license fc
    JOIN egovrti.rti_application ra ON fc.rti_ref_id = ra.rti_application_id
WHERE
    fc.rti_ref_id = $P{rtiapplrefid};]]>
	</queryString>
	<field name="rti_application_ref_id" class="java.lang.String"/>
	<field name="registration_date" class="java.lang.String"/>
	<field name="applicant_name" class="java.lang.String"/>
	<field name="name_of_professional" class="java.lang.String"/>
	<field name="place_of_establishment" class="java.lang.String"/>
	<field name="pavilion_start_date" class="java.lang.String"/>
	<field name="pavilion_end_date" class="java.lang.String"/>
	<detail>
		<band height="1059" splitType="Stretch">
			<textField pattern="">
				<reportElement x="113" y="0" width="331" height="28" uuid="107cdbd4-c603-4d09-ba5f-e9106ad0ee28"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="16" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["कार्यालय, नागपूर महानगरपालिका, नागपूर"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="113" y="29" width="331" height="21" uuid="3880b1a9-5d14-4a7b-9834-c39cca60b891"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<textFieldExpression><![CDATA["(अग्निशमन व आपत्कालीन सेवा विभाग)"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="113" y="48" width="331" height="21" uuid="c76df2f1-4625-4187-a5d3-7d0e643737e9"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="14" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["तात्पुरते फटाके दुकान परवानगीसाठी अर्ज"]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="10" y="81" width="545" height="1" uuid="c0c1bb60-5328-4b9f-afc1-9743d15558c2"/>
			</line>
			<textField>
				<reportElement x="17" y="81" width="243" height="21" uuid="3e4d8870-3560-4f76-8218-858d027fd8ea"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["म.न.पा./अ.शा.से/"+$F{rti_application_ref_id}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="411" y="81" width="145" height="21" uuid="9df8cba2-6252-49fc-a032-fbe2e36a7446"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["दिनांक : "+new SimpleDateFormat("dd-MM-yyyy").format(new java.util.Date())]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="106" width="61" height="25" uuid="5c6101a2-060d-4c92-873a-c002e7080286"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["प्रति,"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="50" y="132" width="505" height="25" uuid="9583ed89-d0ee-4ab2-af01-e2fdc594bf30"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["मेसर्स / श्री. "+$F{applicant_name}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="52" y="157" width="503" height="25" uuid="94608c28-fa7d-4e93-9db1-59cd38cc7235"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["व्यावसायिक /प्रतिष्ठानचे नाव : "+$F{name_of_professional}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="211" width="535" height="25" uuid="d8b1c939-3b0d-4500-9f57-d32c895f90fd">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["विषय :- तात्पुरते चिल्लर फटाका दुकानाचे सशर्त अग्निसुरक्षा प्रमाणपत्र."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="241" width="535" height="62" uuid="89db7e92-5d0a-4e58-872a-39d1c6eb1ad7"/>
				<textElement>
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["          उपरोक्त संदर्भाकित अर्जदाराच्या अनुषंगाने दिवाळी सणानिमित्त उपरोक्त नमुद व्यवसायाच्या ठिकाणी लावण्यात येणाऱ्या फटाका विक्री दुकानाला अर्जासोबत जोडलेल्या हमीपत्राच्या आधारे खालील अग्नी सुरक्षा उपाययोजनाचे पालन करण्याच्या अटीवर पोलिस विभागाद्वारे परवानगी देण्यास हरकत नाही."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="304" width="535" height="25" uuid="457b9d66-1221-4481-b66c-ecb6baa3d77c"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["1. दुकानाचे बांधकाम ज्वलनशील साहित्याचे नसावे."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="329" width="535" height="40" uuid="e20a501c-5cc4-46da-8156-3a558c2f7148">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["2. दुकानातील वुद्यित तारा उघडयावर व लटकलेल्या नसाव्यात, तारा कंडयुट पध्दतीचे असावे व ईएलसीबीजी व्यवस्था असावी."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="368" width="535" height="25" uuid="4e82a3f1-9a05-473f-9470-d6c476ab6472"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["3. विद्युत उपकरणाच्या तारा लगत फटाका साठवलेला नसावा."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="394" width="535" height="40" uuid="a8b5c4bb-fbd5-403b-8991-d2c9f9053929">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["4. फटाका दुकानात ज्वालाग्राही वस्तु किंवा अगरबत्ती अथवा कोणतीही प्रक्रिया ज्याद्वारे आगीची ठिणगी निर्माण होईल अशा वस्तू ठेवू नयो."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="430" width="535" height="40" uuid="9bfdfead-3a48-43ee-a035-9ab17edcbce3">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["5. फटाका विक्रेत्याने दुकानात फटाक्याची मांडणी/साठा अशा प्रकारे करावी जेणेकरुन कोणतीही दुर्घटना घडल्यास पळण्यास सुरक्षित उपलब्ध मार्ग असेल."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="470" width="535" height="40" uuid="241d732b-962a-45e0-be58-9d51041e8753">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["6. 100 चौ. फुट घनक्षेत्रफळा पर्यंतच्या दुकानाकरीता कमीत कमी 2 नग डी. सी. पी./ए.बी.सी. 4 किलोग्राम क्षमतेचे ठेवण्यात यावे व 200 लिटर पाण्याचा 1 ड्रम ठेवण्यात यावा. "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="511" width="535" height="25" uuid="5f6dfbd0-dcb5-4a10-8eae-372446d912b4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["7. दुकानासमोर कोणलाही फटाका फोडण्यास परवानगी देण्यात येवू नये."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="537" width="535" height="25" uuid="c4bad043-67a0-4866-be8d-a1251357e243"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["8. दुकानामध्से फटाका विक्री व्यतिरिक्त अन्य कोणताही व्यवसाय करण्यात येवू नये. "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="563" width="535" height="25" uuid="6d6ea4e6-97f5-48f9-b2d8-3c6d4d77b7e8"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["9. फटाक्याचा साठा पोट माळयावर तसेच बेसमेन्टमध्ये, जिन्यालगत करण्यात येवू नये.  "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="589" width="535" height="25" uuid="478a1305-fc1e-42a9-8914-5ca3b9519621">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["10. फटाक्याची मांडणी दुकानाबाहेर नसावी. तसेच खुले फटाके दुकानासमोर ठेवू नये ते पॉकेट मध्येच असावे."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="615" width="535" height="25" uuid="b6cffaad-b9a6-49ac-81a7-e225b00ca762"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["11. धुम्रपान निषेधाचा सूचनाफलक लावण्यात यावे."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="641" width="535" height="25" uuid="1b341d07-d731-4982-b420-45fcae55c280">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["12. आजुबाजूच्या रहिवाशी/मालमत्ता धारकाचे फटाका दुकानास हरकत नसावी."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="667" width="535" height="25" uuid="a155487e-d884-40d7-b910-ee1bafce13f0">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["13. अर्जदाराने सदर व्यवसायाकरीता पोलिस विभागाची परवानगी घेणे बंधनकारक राहील."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="693" width="535" height="25" uuid="5d44308f-ce4d-48c9-b1d0-d2aea03c4d9b"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["14. आजुबाजुच्या रहिवाशी/मालमत्ता धारकांनी आक्षेप घेतल्यास सदर प्रमाणपत्र रद्द करण्यात येईल."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="720" width="535" height="40" uuid="5f4098d9-4713-4aa8-a983-3165a7c141c5">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement>
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["15. सूचित करण्यात आलेल्या उपाययोजनाच्या अपर्याप्ततेमुळे कोणतीही दुर्घटना घडल्यास व्यवसाय मालक/अर्जदार स्वत: जबाबदार राहील."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="760" width="535" height="60" uuid="cb164207-1341-4c5f-a2c7-0739cb305486"/>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["16. उपरोक्त उपाययोजना संबंधीत सूचनांचे पालन अग्निशमन केंद्र अधिकारी यांच्या निरिक्षणा दरम्यान आढळल्या नाही किंवा उपाययोजना करुनही धोकादायक ठरु शकेल असे वाटल्यास सदर दुकानाची परवानगी रद्द करण्याची शिफारस पोलिस विभागाला करण्यात येईल अथवा अधिक उपाययोजना सुचविण्यात येतील."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="820" width="535" height="38" uuid="f12fa749-16aa-4f1d-be91-8afae6367050"/>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["17. म.न.पा तथा पोलिस विभाग, नागपूर यांच्याद्वारे जाहीर केलेल्या प्रतिबंधित क्षेत्रात सदर तात्पुरते चिल्लर फटाका दुकान असल्यास सदर प्रमाणपत्र रद्द समजण्यात यावे."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="861" width="535" height="84" uuid="e22ee5e4-b5e9-4301-aa1f-13877c34ef28">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["18. सदर तात्पुरते अग्निसुरक्षा सुचना प्रमाणपत्राची मुदत दिनांक "+"_______________________"+"  पर्यंत राहील. विस्फोटक अधिनियम (Explosive Act) 1884 अन्वये अधिक त परवानगी (License Authority) यांनी विस्फोटक अधिनियम 1884 च्या तरतुदीचे पालन होत असल्याची खात्री करुनच व मा. उच्च न्यायालय, मुंबई यांनी जनहित याचिका क्र. 150/2015 मध्ये पारित निर्देशांची पूर्तता करुनच सदर फटाका दुकानाला संबंधितांनी परवानगी द्यावी."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="380" y="1013" width="160" height="25" uuid="eaef939f-9e35-4e39-a88f-63ea41cd5db0"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["अग्निश्मन केंद्र अधिकारी"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="400" y="1034" width="120" height="25" uuid="3b277655-3fac-4a72-924a-246a9167da99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["म.न.पा. नागपूर."]]></textFieldExpression>
