	</parameter>
	<queryString>
		<![CDATA[select 
	mp.*, 
    ra.*, 
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 1) AS first_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 2) AS second_url,
        SPLIT_PART(ra.pdf_upload_from_portal, ',', 3) AS third_url,
                SPLIT_PART(ra.pdf_upload_from_portal, ',', 3) AS forth_url,
                                SPLIT_PART(ra.pdf_upload_from_portal, ',', 3) AS fifth_url,
                                SPLIT_PART(ra.pdf_upload_from_portal, ',', 3) AS sixth_url,
                                SPLIT_PART(ra.pdf_upload_from_portal, ',', 3) AS seventh_url  
    FROM
    egovrti.property_tax_mutation mp
JOIN 
    egovrti.rti_application ra 
    ON mp.rti_ref_id = ra.rti_application_id 
WHERE 
    mp.rti_ref_id = $P{rtiapplrefid};]]>
	</queryString>
