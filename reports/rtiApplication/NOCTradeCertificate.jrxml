			<staticText>
				<reportElement x="26" y="486" width="518" height="35" uuid="a4e4b309-9f61-4138-8d5c-300a6172785f">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[नागरिकांचे, त्यांच्या मिळकतीचे संरक्षण करण्याचे उद्देशाने व नागरिकांना उपद्रव होऊ नये यासाठी परवान्यातील अटी व शर्तींचे काटेकोरपणे पालन करावे लागेल.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="522" width="24" height="34" uuid="8b20edb0-5ac0-420d-90f5-ec686b8bdb6a">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(४)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="522" width="518" height="34" uuid="836d313b-d39c-43e1-9259-a8c150506605"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[यदा कदाचित आगीचा प्रार्दुभाव झाल्यास अग्निशमन दलाच्या अधिकाऱ्याने दिलेल्या सुचनांचे पालन करून परवानाधारकांस ती आग इतरत्र पसरू न देण्यासाठी आवश्यक ती उपाययोजना तात्काळ करावी लागेल.]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="558" width="518" height="18" uuid="953aa45e-6ccb-41c3-aa22-fe110992d018">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[परवाना दिलेल्या जागेचा उपयोग मानवी वस्तीसाठी वा जनावरे किंवा पक्षी ठेवण्यासाठी करता येणार नाही.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="558" width="24" height="18" uuid="0170dd29-7ad5-4602-8680-9d1a075af24d">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(५)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="578" width="518" height="18" uuid="29b80fab-890a-46ee-bfeb-fedad4c1ba76">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[आग पेटविणे वा ज्यामुळे सार्वजनिक सुरक्षेला धोका निर्माण होईल अशी कोणतीही कृती परवानाधारक परवाना दिलेल्या जागी करणार नाही.]]></text>
			</staticText>
			<staticText>
				<reportElement x="2" y="578" width="24" height="18" uuid="103d56be-a493-4e94-b747-86654986cef7"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(६) ]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="598" width="518" height="18" uuid="907b359f-1cb1-40ed-ad03-5270b72eeef2"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[परवाना दिलेल्या जागेच्या बाहेर ठळक जागी खालील तपशील फलक लावणे परवानाधारकावर बंधनकारक राहील. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="598" width="24" height="18" uuid="0e8e9a31-cf7c-4e85-8349-d4fe8f3c502c">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(७)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="618" width="518" height="34" uuid="5c881ccb-9420-4bf9-be0f-73f9c205b2fa">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(अ) परवानाधारकाचे नाव व पत्ता,  (ब) परवान्याचा क्रमांक व त्याची मुदत,  (क) परवानाधारकाच्या गैरहजेरीत नियंत्रण ठेवणाऱ्या व्यक्तीचे नाव व पत्ता]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="654" width="518" height="34" uuid="2f1b3b9a-7d54-4322-967a-d89d64af5fbe">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[ महानगरपालिकेच्या अधिकऱ्यांनी भेट दिल्यावर परवानाधारकाला द्यावयाच्या सुचनांसाठी "भेटी / सूचना रजिस्टर" परवानाधारकाला ठेवावे लागेल.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="618" width="24" height="34" uuid="cdd2ed5d-fbee-416a-b5a7-8f76543958d0">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(८)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="690" width="518" height="50" uuid="d9d9e87e-29ad-49c3-aa94-7518b15a6c15"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[नागपूर महानगरपालिका अधिनियम, १९४९ च्या कलम ३७६ च्या तरतूदीनुसार दिलेल्या या परवान्याव्यतिरिक्त अन्य कायदेशीर तरतुदीच्या अनुषंगाने कोणत्याही अधिनियमाखाली घ्यावे लागणारे परवाने देण्याची जबाबदारी परवानाधारकांवर असेल. त्यानंतरच सदर परवाना लागू राहील.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="654" width="24" height="34" uuid="cb2bce6d-2d63-4ea8-93d7-a116412ba116">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(९) ]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="414" width="24" height="30" uuid="67f355a2-9ded-466d-945b-b263cb298c1d"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(१)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="414" width="518" height="50" uuid="ef676d8b-d7ed-44a5-9ffc-1114a478877d">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[या परवान्याचा मुदत ३१ डिसेंबर रोजी संपणाऱ्या कॅलेंडर वर्षापर्यंत असेल. वर्षाच्या कुठल्याही महिन्यात परवाना प्राप्त झाल्यानंतर त्या वर्षाच्या ३१ डिसेंबर पर्यंत परवाना वैध राहील. परवानाधारकाला "नागपूर महानगरपालिका (विनिर्दिष्ट प्रयोजनासाठी / व्यवसायासाठी जागा वापरण्याचे) स्थायी आदेश, २०२० च्या तरतूदीचे पालन करावे लागेल. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="466" width="518" height="18" uuid="74ea6041-ba3a-40ab-a067-242d375fabab"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[ परवान्यात नमूद केलेल्या व्यवसाया व्यतिरिक्त इतर कोणताही व्यवसाय परवाना दिलेल्या जागेत करता येणार नाही.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="466" width="24" height="18" uuid="3b44e1ff-35fa-4bf4-9c4c-ce893f383cb9">
