	<queryString>
		<![CDATA[SELECT * 
FROM egovrti.mtp_details mtpd
JOIN egovrti.mtp_registration_certificate mtp ON mtpd.mtpid = mtp.mtpid
JOIN egovrti.rti_application ra ON mtp.rti_ref_id = ra.rti_application_id
WHERE mtp.rti_ref_id = $P{rtiapplrefid};]]>
	</queryString>
