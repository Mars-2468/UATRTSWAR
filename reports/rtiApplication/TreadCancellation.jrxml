			<staticText>
				<reportElement x="352" y="730" width="186" height="70" uuid="1880726a-c9c1-4a8f-8749-cf39bb9bd7c3"/>
				<textElement textAlignment="Center">
					<font size="16"/>
				</textElement>
				<text><![CDATA[परवाना देणाऱ्या/नुतनीकरण करणाऱ्या सक्षम प्राधिकाऱ्यांची सही, पदनाम व शिक्का]]></text>
			</staticText>
			<staticText>
				<reportElement x="24" y="446" width="526" height="80" uuid="3bf93d87-f8d2-479d-bae4-b30282d41f72"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<text><![CDATA[तुम्हाला काही प्रश्न असल्यास किंवा आणखी सहाय्य हवे असल्यास कृपया आम्हाला कळवा,   आम्ही तुम्हाला आठवण करून देऊ इच्छितो की तुमचा व्यापार परवाना रद्द केल्याने त्याच्याशी संबंधित सर्व व्यवसायांवर परिणाम होईल. तुम्हाला काही प्रश्न असल्यास किंवा आणखी सहाय्य हवे असल्यास कृपया आम्हाला कळवा]]></text>
			</staticText>
			<image>
				<reportElement x="256" y="8" width="50" height="50" uuid="4d16424a-6488-4b5c-abca-713b5f057b41"/>
				<imageExpression><![CDATA["../../images/amclogodash.jpeg"]]></imageExpression>
			</image>
			<staticText>
				<reportElement x="2" y="109" width="550" height="23" uuid="a1f7731c-66d3-4120-a7b1-84a677323f15"/>
