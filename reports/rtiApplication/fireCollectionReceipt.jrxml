	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="egvNmc"/>
	<parameter name="collection_id" class="java.lang.String"/>
	<parameter name="amc_logo" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    c.collection_id,
    c.payment_mode,
    c.cheque_dd_rtgs_number,
    c.cheque_dd_rtgs_date,
    c.rti_application_id,
    c.receipt_number,
    ra.applicant_name,
    ra.first_payment_fees,
    c.amount,
    frm.address_of_power_attorney ,
    frm.mobile_no ,
    frm.rti_application_ref_id
FROM
    egovrti.rti_application ra
JOIN
    egovrti.collection c ON ra.rti_application_id = c.rti_application_id
join egovrti.fire_recommendation_main frm on frm.rti_ref_id  = c.rti_application_id 
WHERE
    c.collection_id  = $P{collection_id};]]>
	</queryString>
