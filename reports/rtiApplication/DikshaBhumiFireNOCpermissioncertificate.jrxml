				<staticText>
					<reportElement x="30" y="129" width="523" height="40" uuid="7f138c99-0d0b-40e0-aeeb-0c164b3a46f4"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[सर्व विद्युत उपकरणे हे आय.एस.एय मार्क चे व योग्य क्षमतेचे असावेत तसेच स्वयंचलीत विद्युत खंडित यंत्रणा (ELCB,MCB) उपाययोजना करण्यात यावी.]]></text>
				</staticText>
				<staticText>
					<reportElement x="30" y="169" width="518" height="40" uuid="f162b591-2cc4-4d94-bc1f-9b1e1ef04301"/>
					<textElement textAlignment="Justified">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[वरीलप्रमाणे आग प्रतिबंधक व जिवसंरक्षक उपाययोजना करण्याच्या अटीवर सशर्त आग संरक्षक मान्यता प्रमाणपत्र निर्गमित करण्यात येत आहे.]]></text>
				</staticText>
			</frame>
			<staticText>
				<reportElement x="350" y="679" width="178" height="20" uuid="34a9ded5-f796-46cb-a098-0d3509bce547"/>
				<textElement>
					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<text><![CDATA[अग्निशमन  कें द्र अधिकारी ,
]]></text>
			</staticText>
			<staticText>
				<reportElement x="270" y="699" width="281" height="60" uuid="94bd6ef7-f2dc-48c9-91ab-b23b6b0dfdff"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<text><![CDATA[अग्निशमन  कें द्र,
अग्निशमन आपत्कालीन सेवा,विभाग ,
म.न.पा. नागपूर.]]></text>
