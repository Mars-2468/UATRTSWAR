			<staticText>
				<reportElement x="3" y="386" width="549" height="57" uuid="ffbf6e34-a32a-482f-9d87-f5a1cb42be85"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[ अर्जात दिलेल्या माहितीप्रमाणे आपले नियोजित तात्पुरते मंडपाचे क्षेत्रफळ लक्षात घेता महाराष्ट्र आग प्रतिबंधक व जिवसंरक्षक उपाययोजना अधिनियम २००६ व सुधारणा अधिनियम २०२३ तथा भारतीय राष्ट्रीय इमारत संहिता २०१६ च्या कलम ३.२.५ च्या तरतुदीनुसार तात्पुरते मंडपाच्या उभारणीकरीता किमान आग प्रतिबंधक व जिवसंरक्षक उपाययोजना करणे बंधनकारक आहे.]]></text>
			</staticText>
			<frame>
				<reportElement x="-3" y="449" width="560" height="230" uuid="efbeb058-2e4a-4202-ba62-f721c057322c"/>
				<staticText>
					<reportElement x="31" y="-11" width="526" height="40" uuid="9b2b252a-ad15-4799-8000-0365bb460c6d"/>
					<textElement textAlignment="Left">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[त्या अनुषंगाने उभारण्यात येणारे तात्पुरते मंडप करीता आग प्रतिबंधक व जिवसुरक्षेच्या दुष्टीने खालीलप्रमाणे उपाययोजना करण्यात यावे.]]></text>
				</staticText>
				<staticText>
