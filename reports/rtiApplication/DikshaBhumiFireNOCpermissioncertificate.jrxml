					<textElement textAlignment="Justified">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[गॅसबत्ती, केरोसीनवर चालणारे दिवे, मेणबत्ती, शेगडी, गॅस सिलेंडर, ज्वलनशील पदार्थ तथा स्फोटके, लाकडे, सुखे गवत इत्यादीचा साठा परिसरात ठेवण्यात येवू नये.]]></text>
				</staticText>
				<staticText>
