<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="GaneshSummary" pageWidth="1162" pageHeight="842" columnWidth="1162" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="086236e1-59d9-401e-acae-28f305406971">
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="egvNmc"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<queryString>
		<![CDATA[WITH cte AS (
  SELECT ra.*, dump.*,
    CASE 
      WHEN ra.workflow_status IN (2, 1) THEN 'Yes'
      ELSE 'No'
    END AS demandpaid,

    CASE 
      WHEN ra.workflow_status = 3 THEN 'Yes'
      ELSE 'No'
    END AS demandsend,

    CASE 
      WHEN dump.police_noc IS NOT NULL 
        AND dump.traffic_noc IS NOT NULL 
        AND dump.fire_noc IS NOT NULL THEN 'Yes'
      ELSE 'No'
    END AS nocstatus

  FROM egovrti.rti_application ra
  JOIN egovrti.durga_utsav_mandap_permission dump 
  ON dump.rti_ref_id = ra.rti_application_id
  WHERE dump.rti_ref_id = ra.rti_application_id
    AND ra.rti_application_number IS NOT NULL
    AND ra.rti_application_number != ''
)
SELECT *
FROM cte
ORDER BY zone_no ASC;]]>
	</queryString>
