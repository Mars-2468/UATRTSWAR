	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="FROM_DATE" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="TO_DATE" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="WARD_ID" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    sc.zone_name,
    sc.cleaning_date,
    sc.fire_station_name,
    sc.statue_list,
    sc.encoded_files_path,
    (string_to_array(TRIM(sc.encoded_files_path), ','))[1] AS file_url_1,
    (string_to_array(TRIM(sc.encoded_files_path), ','))[2] AS file_url_2,
    (string_to_array(TRIM(sc.encoded_files_path), ','))[3] AS file_url_3
FROM 
    egovrti.statue_cleaning sc
WHERE 
    TO_DATE(sc.cleaning_date, 'yyyy-mm-dd') BETWEEN TO_DATE($P{FROM_DATE}, 'yyyy-mm-dd') 
    AND TO_DATE($P{TO_DATE}, 'yyyy-mm-dd')
ORDER BY 
    sc.cleaning_date ASC]]>
	</queryString>
	<field name="zone_name" class="java.lang.String"/>
	<field name="cleaning_date" class="java.lang.String"/>
	<field name="fire_station_name" class="java.lang.String"/>
	<field name="statue_list" class="java.lang.String"/>
	<field name="encoded_files_path" class="java.lang.String"/>
	<field name="file_url_1" class="java.lang.String"/>
	<field name="file_url_2" class="java.lang.String"/>
	<field name="file_url_3" class="java.lang.String"/>
	<variable name="s .no" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[new Integer(1)]]></variableExpression>
	</variable>
