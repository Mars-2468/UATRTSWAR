	</parameter>
	<queryString>
		<![CDATA[SELECT 
    mp.*, 
    ra.*, 
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 1) AS first_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 2) AS second_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 3) AS third_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 4) AS fourth_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 5) AS fifth_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 6) AS sixth_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 7) AS seventh_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 8) AS eighth_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 9) AS ninth_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 10) AS tenth_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 11) AS elevnth_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 12) AS telveth_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 13) AS thirdinth_url

FROM 
    egovrti.new_water_connection mp
JOIN 
    egovrti.rti_application ra 
    ON mp.rti_ref_id = ra.rti_application_id 
WHERE 
    mp.rti_ref_id = $P{rtiapplrefid};]]>
	</queryString>
