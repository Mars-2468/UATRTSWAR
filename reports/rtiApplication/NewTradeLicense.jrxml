				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(नागपूर महानगरपालिका अधिनियम १९४९ मधील कलम ३७६ प्रमाणे विनिर्दिष्ट प्रयोजनासाठी )]]></text>
			</staticText>
			<staticText>
				<reportElement x="30" y="210" width="489" height="20" uuid="1d63a984-459c-4c13-8038-1a4d313072da"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="11"/>
				</textElement>
				<text><![CDATA[महाराष्ट्र महानगरपालिका अधिनियम, १९४९ चे कलम ३७६ पोट कलम (१) कंडिका (ज) व कलम ३८६ (१) तरतुदीनुसार]]></text>
			</staticText>
			<frame>
