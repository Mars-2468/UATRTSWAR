						<font size="14"/>
					</textElement>
					<text><![CDATA[2.]]></text>
				</staticText>
				<textField>
					<reportElement x="30" y="100" width="462" height="20" uuid="49645357-1b2c-4de7-8004-ce4f2320fa8c"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<textFieldExpression><![CDATA["परवाना शुल्क रु :- " +$F{fees_applicable} +"  व्यापार परवान्याच्या नूतनीकरणासाठी वर दिले जाते "]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="30" y="40" width="462" height="20" uuid="cebfcd19-2174-4019-a0bf-9783a32eb327"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<textFieldExpression><![CDATA["जारी केल्याच्या तारखेपासून. हे प्रमाणपत्र ३१-मार्च  "+(new SimpleDateFormat("yyyy")).format(new Date())+"   पर्यंतच्या कालावधीसाठी वैध आहे."]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="30" y="10" width="290" height="20" uuid="1f6983a2-6e50-4f8e-b7ce-d4c0cfae8814"/>
