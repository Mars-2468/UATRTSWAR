			</frame>
			<staticText>
				<reportElement x="27" y="350" width="491" height="20" uuid="d41f9f2f-d6ad-4ca3-9466-1658eaeaf4f7"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<text><![CDATA[अटी व शर्ती]]></text>
			</staticText>
			<frame>
				<reportElement x="2" y="370" width="550" height="390" uuid="c735b4e7-0049-4156-a109-0634670a197e"/>
				<staticText>
					<reportElement x="34" y="0" width="516" height="59" uuid="2a790102-69ee-4ebd-848d-29d61cd79885"/>
					<textElement textAlignment="Justified">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[या परवान्याचा मुदत ३१ डिसेंबर रोजी संपणाऱ्या कॅलेंडर वर्षापर्यंत असेल. वर्षाच्या कुठल्याही महिन्यात परवाना प्राप्त झाल्यानंतर त्या वर्षाच्या ३१ डिसेंबर पर्यंत परवाना वैध राहील. परवानाधारकाला "नागपूर महानगरपालिका (विनिर्दिष्ट प्रयोजनासाठी / व्यवसायासाठी जागा वापरण्याचे) स्थायी आदेश, २०२० च्या तरतूदीचे पालन करावे लागेल. ]]></text>
				</staticText>
				<staticText>
					<reportElement x="34" y="60" width="516" height="20" uuid="d5f91e46-389e-4ace-9c3a-6b79bd207556"/>
					<textElement textAlignment="Justified">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[ परवान्यात नमूद केलेल्या व्यवसाया व्यतिरिक्त इतर कोणताही व्यवसाय परवाना दिलेल्या जागेत करता येणार नाही.]]></text>
				</staticText>
				<staticText>
					<reportElement x="2" y="59" width="32" height="23" uuid="78bb6681-a589-430b-b29e-45f8a42fa1db"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[(२)]]></text>
				</staticText>
				<staticText>
					<reportElement x="2" y="10" width="32" height="30" uuid="5eca4caa-1f1d-4eac-9914-b3bac1ce3380"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[(१)]]></text>
				</staticText>
				<staticText>
					<reportElement x="2" y="90" width="32" height="20" uuid="43552abc-b226-43f0-b58c-7423e5957b86"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[(3)]]></text>
				</staticText>
				<staticText>
					<reportElement x="34" y="85" width="516" height="35" uuid="e11d8197-93f9-4376-b815-8bcb702775ac"/>
					<textElement textAlignment="Justified">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[नागरिकांचे, त्यांच्या मिळकतीचे संरक्षण करण्याचे उद्देशाने व नागरिकांना उपद्रव होऊ नये यासाठी परवान्यातील अटी व शर्तींचे काटेकोरपणे पालन करावे लागेल.]]></text>
				</staticText>
				<staticText>
					<reportElement x="0" y="120" width="33" height="20" uuid="8abcb1f0-c2ec-4267-8e54-9f5956f4f3b4"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[(४)]]></text>
				</staticText>
				<staticText>
					<reportElement x="34" y="120" width="516" height="40" uuid="6f094f06-dc18-43ee-bf8c-0ac3657879e3"/>
					<textElement textAlignment="Justified">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[यदा कदाचित आगीचा प्रार्दुभाव झाल्यास अग्निशमन दलाच्या अधिकाऱ्याने दिलेल्या सुचनांचे पालन करून परवानाधारकांस ती आग इतरत्र पसरू न देण्यासाठी आवश्यक ती उपाययोजना तात्काळ करावी लागेल.]]></text>
				</staticText>
				<staticText>
					<reportElement x="34" y="160" width="516" height="20" uuid="f8119dc9-4a68-45cb-953d-c9dcf08ff571"/>
					<textElement textAlignment="Justified">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[परवाना दिलेल्या जागेचा उपयोग मानवी वस्तीसाठी वा जनावरे किंवा पक्षी ठेवण्यासाठी करता येणार नाही.]]></text>
				</staticText>
				<staticText>
					<reportElement x="0" y="160" width="33" height="20" uuid="975ca294-349c-4c9c-9a04-690f9ad13be2"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[(५)]]></text>
				</staticText>
				<staticText>
					<reportElement x="34" y="180" width="516" height="30" uuid="087eab8f-3c71-4ec1-8944-6b52bc701d25"/>
					<textElement textAlignment="Justified">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[आग पेटविणे वा ज्यामुळे सार्वजनिक सुरक्षेला धोका निर्माण होईल अशी कोणतीही कृती परवानाधारक परवाना दिलेल्या जागी करणार नाही.]]></text>
				</staticText>
				<staticText>
					<reportElement x="2" y="180" width="32" height="20" uuid="fc3bc540-9950-49b1-9544-da199c5db9f0"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[(६) ]]></text>
				</staticText>
				<staticText>
					<reportElement x="34" y="210" width="516" height="20" uuid="f4b9b298-f786-4887-8c6d-e5d393d84f39"/>
					<textElement textAlignment="Justified">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[परवाना दिलेल्या जागेच्या बाहेर ठळक जागी खालील तपशील फलक लावणे परवानाधारकावर बंधनकारक राहील. ]]></text>
				</staticText>
				<staticText>
					<reportElement x="2" y="210" width="32" height="20" uuid="f5fcbd89-abba-4204-bc1e-187076f7d22e"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[(७)]]></text>
				</staticText>
				<staticText>
					<reportElement x="34" y="230" width="516" height="40" uuid="47381054-0c65-4f54-860f-f92be6601f76"/>
					<textElement textAlignment="Justified">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[(अ) परवानाधारकाचे नाव व पत्ता,  (ब) परवान्याचा क्रमांक व त्याची मुदत,  (क) परवानाधारकाच्या गैरहजेरीत नियंत्रण ठेवणाऱ्या व्यक्तीचे नाव व पत्ता]]></text>
				</staticText>
				<staticText>
					<reportElement x="34" y="270" width="516" height="30" uuid="aa51db98-57be-4803-8ed2-7fbc5f73f9bf"/>
					<textElement textAlignment="Justified">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[ महानगरपालिकेच्या अधिकऱ्यांनी भेट दिल्यावर परवानाधारकाला द्यावयाच्या सुचनांसाठी "भेटी / सूचना रजिस्टर" परवानाधारकाला ठेवावे लागेल.]]></text>
				</staticText>
				<staticText>
					<reportElement x="2" y="270" width="32" height="27" uuid="8bf83e1c-8897-41a7-a157-3d8cdc3c40ab"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[(८)]]></text>
				</staticText>
				<staticText>
					<reportElement x="34" y="300" width="516" height="50" uuid="f3971d77-a1c8-4ed2-95e1-ad42984cce4b"/>
					<textElement textAlignment="Justified">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[नागपूर महानगरपालिका अधिनियम, १९४९ च्या कलम ३७६ च्या तरतूदीनुसार दिलेल्या या परवान्याव्यतिरिक्त अन्य कायदेशीर तरतुदीच्या अनुषंगाने कोणत्याही अधिनियमाखाली घ्यावे लागणारे परवाने देण्याची जबाबदारी परवानाधारकांवर असेल. त्यानंतरच सदर परवाना लागू राहील.]]></text>
