				</staticText>
				<textField>
					<reportElement x="30" y="60" width="462" height="40" uuid="686d6871-a175-4325-a0ef-ff876cc0a418"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<textFieldExpression><![CDATA["श्री/श्रीमती  "+$F{full_name}+"  यांना व्यापार परवाना जारी केला जातो. "+"  परवानगी क्रमांक  : -  "+$F{trade_new_id}+"  "+$F{full_address}+"  प्रभाग :-"+$F{ward_no}]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement x="1" y="100" width="29" height="20" uuid="c3c10d00-5992-4f79-a205-ce6003f76782"/>
