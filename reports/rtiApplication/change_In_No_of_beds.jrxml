<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Certificate_of_Nursing_Registration" pageWidth="560" pageHeight="790" columnWidth="520" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="0" isIgnorePagination="true" uuid="604a6bc3-ae55-4fb3-995f-76c562a21e2b">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="EGOV_NMC_UAT"/>
	<parameter name="rtiapplrefid" class="java.lang.String"/>
	<parameter name="head_type" class="java.lang.String"/>
	<parameter name="title" class="java.lang.String"/>
	<queryString>
		<![CDATA[WITH ranked_records AS (
    SELECT 
        rnr.place as place,
        $P{title} as title,
        CASE 
            WHEN $P{head_type} = 3 THEN 
                rnr.sanctioned_bed_maternity 
            ELSE 
                rnr.change_bed_maternity
        END as maternity_beds,
        CASE 
            WHEN $P{head_type} = 3 THEN 
                rnr.sanctioned_bed_other 
            ELSE 
                rnr.change_bed_other
        END as other_beds,
        CASE 
            WHEN rnr.my_dropdown1 = 5 THEN 
                nodc.change_owner_name 
            ELSE 
                nod.owner_name 
        END as name,
        rnr.rti_appl_ref_no as rts_app_no,
        --TO_CHAR(TO_DATE(rnr.certificate_issued_date , 'dd-mm-yyyy HH24:MI:SS'), 'dd-mm-yyyy') AS to_date,
        TO_CHAR(TO_DATE(ra.registration_date, 'dd-mm-yyyy HH24:MI:SS'), 'dd-mm-yyyy') AS registrationdate,
        ROW_NUMBER() OVER (PARTITION BY rnr.my_dropdown1 ORDER BY case when rnr.my_dropdown1 = 5 then nodc.nbc_id else nod.nbc_id end ASC) AS rn
        
    FROM
        egovrti.nursing_home_changes_application rnr
    JOIN
        egovrti.rti_application ra ON ra.rti_application_id = rnr.rti_ref_id
    LEFT JOIN 
        egovrti.nursing_owner_details_change nodc ON rnr.my_dropdown1 = 5 AND nodc.nhca_id = rnr.nhca_id 
    LEFT JOIN 
        egovrti.nursing_owner_details nod ON rnr.my_dropdown1 = 6 AND nod.nhca_id = rnr.nhca_id 
    WHERE
        rnr.rti_ref_id = $P{rtiapplrefid} 
        AND rnr.my_dropdown = $P{head_type}
)
SELECT
    name,
    place,
    title,
    maternity_beds,
    other_beds,
    name,
    rts_app_no,
    registrationdate
FROM
    ranked_records
WHERE
    rn=1;]]>
	</queryString>
