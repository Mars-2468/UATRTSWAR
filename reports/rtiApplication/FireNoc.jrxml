	</parameter>
	<queryString>
		<![CDATA[SELECT

    /* =========================
       FIRE RECOMMENDATION MAIN
       ========================= */

    frm.fire_recommendation_id,
    frm.catagory,
    frm.title,
    frm.first_name,
    frm.middle_name,
    frm.last_name,
    frm.full_name,
    frm.flat_no,
    frm.survey_no,
    frm.street_name,
    frm.house_no,
    frm.pin_code,
    frm.landmark,
    frm.mobile_no,
    frm.app_email,
    frm.nameofpower_attorney,
    frm.no_standby,
    frm.address_of_power_attorney,
    frm.hight_of_building,
    frm.floors,
    frm.type_of_building,
    frm.subtype_of_building,
    frm.type_of_height,
    frm.type_of_construction,

    frm.total_plot_area,
    frm.build_up_area,
    frm.super_build_area,
    frm.number_of_building,
    frm.num_of_wings,
    frm.present_position,

    frm.front_margin_width,
    frm.real_margin,
    frm.side_margine,
    frm.side_margine_two,

    frm.width_of_entrance,
    frm.height_of_entrance,

    frm.number_of_external,
    frm.width_of_external,

    frm.from_internal_staricase,
    frm.from_external_staricase,

    frm.num_internal_staircase_provided,
    frm.width_internal_staircase_provided,

    frm.no_lift,
    frm.type_of_lift,

    frm.area_of_basement,

    frm.capacity_of_undergroundank,
    frm.capacity_ofover_headtank,

    frm.fire_fighting_systemnbc,
    frm.location_of_transferroom,

    frm.electric_pump,
    frm.electric_pump_capacity,

    frm.diesel_pump,
    frm.diesel_pump_capacity,

    frm.jocky_pump,
    frm.jocky_pump_capacity,

    frm.booster_pump,
    frm.booster_pump_capacity,

    frm.num_stand_by,
    frm.ac_plant,

    frm.zone_no,
    frm.nooffloors,
    frm.super_build_up_area,

    frm.scrutiny_fees_on_above_total,

    frm.rti_application_ref_id,
    frm.rti_ref_id,

    frm.title_architecture,
    frm.first_name_architecture,
    frm.middle_name_architecture,
    frm.last_name_architecture,
    frm.full_name_architecture,

    frm.mobile_no_architecture,
    frm.app_email_architecture,
    frm.architect_licence_number,

    frm.name_of_building_owner,
    frm.address_of_building,

    frm.sheet_no,
    frm.khasara_no,
    frm.ward_no,

    frm.east,
    frm.west,
    frm.north,
    frm.south,

    frm.total_fees,

    frm.scrutiny_report,
    frm.inspection_report,
    frm.cfo_noc,
    frm.fire_noc,
    frm.building_plan_map,

    frm.remarkfor_citizen,
    frm.remarkfor_l2,
    frm.sent_to_citizen,

    frm.fees_remarks,
    frm.updated_scrutinyfees,
    frm.updated_totalfees,

    frm.fire_department_wise_login,
    frm.fire_sub_department_wise_login,

    frm.first_payment_fees,

    /* =========================
       FIRE DETAILS
       ========================= */

    fd.fire_details_id,
    fd.floor_name AS detail_floor_name,
    fd.firefloortypes,
    fd.comm_area AS detail_comm_area,
    fd.resid_area AS detail_resid_area,
    fd.primumar AS detail_primumar,
    fd.other_use AS detail_other_use,
    fd.total_table,
    fd.row_wise_total,

    /* =========================
       RTI APPLICATION
       ========================= */

    ra.rti_application_id,
    ra.rti_application_number,
    ra.inward_number,
    ra.registration_date,
    ra.received_date,
    ra.closed_date,
    ra.subject,
    ra.department,
    ra.information_required,

    ra.number_of_copies,
    ra.amount_per_copy,
    ra.application_cost,

    ra.workflow_status,
    ra.final_status,

    ra.created_date,
    ra.template_name,

    ra.zone,

    ra.applicant_name,
    ra.gender,
    ra.state,
    ra.phone_number,
    ra.mobile_number,
    ra.email,

    ra.pincode,
    ra.bpl,
    ra.bpl_card_number,

    ra.address_line1,
    ra.address_line2,
    ra.district,

    ra.postal_charges,

    ra.rti_application_ref_number,
    ra.rti_application_ref_id,

    ra.pdf_files_saved_path,
    ra.pdf_upload_from_portal,

    ra.police_noc,
    ra.fire_noc AS rti_fire_noc,
    ra.traffic_noc,
    ra.zone_map,

    ra.property_payment_receipt,
    ra.rejectionletter,
    ra.property_tax_certificate,

    ra.demandletter,
    ra.noc,

    ra.first_payment_fees AS rti_first_payment_fees,

    ra.tax_other_citizen_document_upload,
    ra.citizennoc,
    ra.plantationletter,

    ra.workflow_comments,

    /* =========================
       UPLOADED DOCUMENT URLs
       ========================= */

    SPLIT_PART(
        ra.pdf_upload_from_portal,
        ',',
        1
    ) AS first_url,

    SPLIT_PART(
        ra.pdf_upload_from_portal,
        ',',
        2
    ) AS second_url,

    SPLIT_PART(
        ra.pdf_upload_from_portal,
        ',',
        3
    ) AS third_url,

    SPLIT_PART(
        ra.pdf_upload_from_portal,
        ',',
        4
    ) AS fourth_url,

    SPLIT_PART(
        ra.pdf_upload_from_portal,
        ',',
        5
    ) AS fifth_url

FROM egovrti.fire_recommendation_main frm

JOIN egovrti.fire_details fd
    ON fd.fire_recommendation_id = frm.fire_recommendation_id

JOIN egovrti.rti_application ra
    ON frm.rti_ref_id = ra.rti_application_id

WHERE frm.rti_ref_id = $P{rtiapplrefid}

ORDER BY fd.fire_details_id;]]>
	</queryString>
