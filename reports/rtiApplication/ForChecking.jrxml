					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<text><![CDATA[इ) मंडळाचे नाव व पत्ता]]></text>
			</staticText>
			<staticText>
				<reportElement x="130" y="369" width="18" height="20" uuid="de7e92bb-3a53-42f6-b8fc-00c1a6949448"/>
				<textElement textAlignment="Left">
					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<text><![CDATA[:-]]></text>
			</staticText>
			<staticText>
				<reportElement x="130" y="391" width="18" height="20" uuid="6dfccd68-34bd-4f19-8faa-960dc2703970"/>
				<textElement textAlignment="Left">
					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<text><![CDATA[:-]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="702" width="508" height="65" uuid="a80f4e0d-ec0d-44c1-82b5-38d2a9fae5f0"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[दिलेल्या परवानगी नुसार संरचना नसल्यास किवा दिलेल्या प्रयोजना करिता जागेच्या वापर होत नसून इतर प्रयोजना करिता होत आहे. किंवा खोटे व बनावटी दस्ताऐवजांच्या आधारावर परवानगी मिळविण्यात आलेली आहे तर दिलेली परवानगी परत किंवा निरस्त/रद्द करण्यात येईल. याकरिता अर्जदाराला किंवा संस्थेला झालेल्या कोणत्याही प्रकारच्या नुकसानाची भरपाई महानगर पालिकाद्वारे करण्यात येणार नाही.]]></text>
			</staticText>
			<staticText>
				<reportElement x="19" y="702" width="20" height="35" uuid="0247edef-9428-4171-b474-a13c39c2f00b">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
