			</staticText>
			<staticText>
				<reportElement x="45" y="425" width="508" height="50" uuid="05ff8ccf-3ecd-4b78-b056-a22da13ec2eb"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[विभागीय कार्यालय तर्फे प्राप्त ना हरकत प्रमाणपत्र/अभिप्राय पोलीस विभाग, अग्निशमन विभाग आणि विद्युत विभाग इत्यादी विभागाकडून ना हरकत प्रमाणपत्र व परवानगी पत्रातील अटी व शर्ती च्या अधीन राहून परवानगी देण्यात येत आहे.]]></text>
			</staticText>
			<staticText>
				<reportElement x="20" y="259" width="110" height="20" uuid="602b0e17-0839-4c68-bffb-3d50a8b40f9f"/>
