			<frame>
				<reportElement x="2" y="370" width="557" height="330" uuid="133349b0-3dc0-4358-816c-b6c2554f7842"/>
				<staticText>
					<reportElement x="40" y="10" width="515" height="50" uuid="9a1e2210-0bcb-4d30-814f-2f75cf5cb571"/>
					<textElement textAlignment="Justified">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[गणेश मूर्तीचे मंडपामुळे वाहतुकीस अडथळा निर्माण होणार नाही. तसेच मा. उच्च न्यायालयाचे याचिका क्र. ६१७७/२००६ दि. १६/०९/२००९ अन्वये मा. उच्च न्यायालयाने दिलेल्या अंतरीम आदेशान्वये वाहतूक नियमांचे उल्लंघन होणार नाही.]]></text>
				</staticText>
				<staticText>
					<reportElement x="1" y="10" width="40" height="30" uuid="14ab9225-1fee-47b2-b8d9-785b741d8695"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[१.]]></text>
				</staticText>
				<staticText>
					<reportElement x="40" y="60" width="515" height="50" uuid="1221e618-2f7d-47c6-a5aa-866362ba60a5"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[ध्वनिक्षेपकाचा आवाज नियम ७ ध्वनिप्रदूषण नियम २००० कलम १५, पर्यावरण संरक्षण अधिनियम १९९६ नुसार निवासी क्षेत्रात दिवसा ५५ डेसिबल व रात्री ४५ डेसिबल पेक्षा जास्त आवाज राहणार नाही याची आयोजकान दक्षता घ्यावी.]]></text>
				</staticText>
				<staticText>
					<reportElement x="0" y="60" width="39" height="30" uuid="aaee4a5d-aec2-4564-b96c-1265c11873e4"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[२]]></text>
				</staticText>
				<staticText>
					<reportElement x="40" y="110" width="515" height="40" uuid="929d2f38-1070-4689-9951-ff2f2fde7c18"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[रात्री १०.०० वाजता नंतर कोणत्याही प्रकारच्या लाउडस्पिकर/वाद्य वाजविणार नाही. याची आयोजकाने दक्षता घ्यावी.]]></text>
				</staticText>
				<staticText>
					<reportElement x="0" y="110" width="39" height="30" uuid="f7010bdc-8c58-4aa9-9159-d5f893dec4c6"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[३ ]]></text>
				</staticText>
				<staticText>
					<reportElement x="39" y="150" width="509" height="20" uuid="d65cd0e3-94c6-44a7-b31c-3025e668d232"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[गणपती आगमन व विसर्जन मिरवणूक दरम्यान डी. जे साउंड सिस्टम राहणार नाही. याची आयोजकाने दक्षता घ्यावी.]]></text>
				</staticText>
				<staticText>
					<reportElement x="-1" y="150" width="39" height="20" uuid="b5334822-afae-4d6d-aa5e-5d5069d1f7af"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[४]]></text>
				</staticText>
				<staticText>
					<reportElement x="40" y="170" width="515" height="20" uuid="28cd3f1b-ea5a-46ee-b9a2-3e6b81625b5b"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[गणेश उत्सवा दरम्यान गणेश मूर्तीच्या स्वरंक्षणा करिता दिवस व रात्र पाळीत स्वयंसेवक नेमतील.]]></text>
				</staticText>
				<staticText>
					<reportElement x="-1" y="170" width="40" height="20" uuid="f8b764eb-771c-4627-bac9-b6aca5aa5b7e"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[५]]></text>
				</staticText>
				<staticText>
					<reportElement x="39" y="190" width="516" height="20" uuid="eb84eec3-2606-4e73-a5f6-08ebd8a2bbd0"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[परवानगी मध्ये गणेश मूर्तीचे स्थापनेचे ठिकाण दाखविले, त्याच ठिकाणावर गणेश मूर्तीची स्थापना करावी.]]></text>
				</staticText>
				<staticText>
					<reportElement x="0" y="190" width="39" height="20" uuid="9d9da28d-7265-4110-a1c6-44e0a182200b"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[६]]></text>
				</staticText>
				<staticText>
					<reportElement x="39" y="210" width="508" height="40" uuid="e0c7dfb2-8dc0-497f-9772-4e748dd37102"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[परवानगी मधील अटी व शर्तीचे तंतोतंत पालन करावे व ज्या दिवशी विसर्जनाची तारीख ठरलेली आहे त्याच दिवशी गणपतीचे विसर्जन करतील.
]]></text>
				</staticText>
				<staticText>
					<reportElement x="0" y="211" width="39" height="30" uuid="42e6adc8-2ad7-4a2c-a7f6-01ea4241a2ad"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[७]]></text>
				</staticText>
				<staticText>
					<reportElement x="39" y="250" width="517" height="20" uuid="d97d732c-f0dc-40f7-9635-a96f2a8de6e0"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[वाहतूक विभागाची व धर्मदाय आयुक्त यांची परवानगी घेणे अनिवार्य आहे.]]></text>
				</staticText>
				<staticText>
					<reportElement x="39" y="270" width="515" height="40" uuid="71b5157b-a72e-4aa6-91eb-a5d9a59eb309"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[नमूद पत्र हे नाहरकत प्रमाणपत्र असून परवानगी नव्हे. परवानगी हि नागपूर महानगरपालिका, नागपूर किंवा झोन कार्यालय यांचे कडूनच देण्यात येईल.
करिता ना हरकत प्रमाणपत्र सादर.]]></text>
				</staticText>
				<staticText>
					<reportElement x="0" y="250" width="38" height="23" uuid="096fb126-fbaa-4e5a-89ee-7924f5def6f0"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[८]]></text>
				</staticText>
				<staticText>
					<reportElement x="0" y="273" width="38" height="31" uuid="9aa275dc-1735-4ca2-8b32-4e7d3407d9b9"/>
					<textElement textAlignment="Center">
						<font fontName="Arial Unicode MS" size="12"/>
					</textElement>
					<text><![CDATA[९ ]]></text>
				</staticText>
			</frame>
			<staticText>
				<reportElement x="356" y="740" width="191" height="20" uuid="a4561287-dbad-41b2-ba4a-68f71b2b3c47"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<text><![CDATA[वरिष्ठ पोलिस निरीक्षक,]]></text>
			</staticText>
			<staticText>
				<reportElement x="356" y="760" width="191" height="30" uuid="aba4a1ab-3a92-4a3f-ab42-389ce7852caf"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="16"/>
				</textElement>
				<text><![CDATA[नागपूर शहर.
]]></text>
			</staticText>
			<staticText>
				<reportElement x="23" y="311" width="531" height="59" uuid="21b6803d-b130-48a8-bf08-8007c267eded"/>
				<textElement textAlignment="Left">
					<font fontName="Arial Unicode MS" size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[यांचे कडून ना हरकत प्रमाणपत्राकरिता पो. स्टे. ला अर्ज प्राप्त झाले आहे. त्या अनुषंगाने खालील अटी व शर्तीवर तसेच आपल्या विभागा मार्फतीने जागेची पाहणी करून आपल्या विविध अटी व शर्तीचे बंधन घालून परवानगी देण्यास आमची हरकत नाही.]]></text>
			</staticText>
			<textField>
				<reportElement x="356" y="720" width="188" height="20" uuid="d95f13a8-95e9-42de-bdfa-f29142561754"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="14"/>
				</textElement>
				<textFieldExpression><![CDATA["झोन क्र. :-" +$F{zone_no}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="96" width="555" height="1" uuid="ad9c764c-cbe8-4fc3-bd30-f174d0085f40"/>
