				<staticText>
					<reportElement x="46" y="4" width="507" height="20" uuid="740d58e1-aac9-4f8a-9226-739cf9d910cb"/>
					<textElement textAlignment="Left">
						<font fontName="Arial Unicode MS" size="14"/>
					</textElement>
					<text><![CDATA[श्री गणेश उत्सव संबंधाने अस्थायी मंडप उभारण्याकरिता पोलीस विभागाच्या दृष्टीने ना-हरकत प्रमाणपत्र.]]></text>
				</staticText>
				<textField>
					<reportElement x="4" y="25" width="549" height="21" uuid="b22287ff-063c-4669-b408-825c8e2d8ffa"/>
					<textElement>
						<font fontName="Arial Unicode MS" size="14"/>
					</textElement>
					<textFieldExpression><![CDATA["संदर्भ :- श्री गणेश स्थापना ना-हरकत प्रमाणपत्र " +
Integer.toString(java.util.Calendar.getInstance().get(java.util.Calendar.YEAR))
    .replace('0','०').replace('1','१').replace('2','२').replace('3','३')
    .replace('4','४').replace('5','५').replace('6','६').replace('7','७')
    .replace('8','८').replace('9','९')
+ "-" +
String.format("%02d", (java.util.Calendar.getInstance().get(java.util.Calendar.YEAR)+1)%100)
    .replace('0','०').replace('1','१').replace('2','२').replace('3','३')
    .replace('4','४').replace('5','५').replace('6','६').replace('7','७')
    .replace('8','८').replace('9','९')
+"  बाबत."]]></textFieldExpression>
				</textField>
