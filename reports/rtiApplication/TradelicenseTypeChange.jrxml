					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(3)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="557" width="518" height="35" uuid="a6d95bd0-56e8-4bbd-a526-75f25252c8ab">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[नागरिकांचे, त्यांच्या मिळकतीचे संरक्षण करण्याचे उद्देशाने व नागरिकांना उपद्रव होऊ नये यासाठी परवान्यातील अटी व शर्तींचे काटेकोरपणे पालन करावे लागेल.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="593" width="24" height="34" uuid="307f4f2f-1e02-4a91-b6e2-a0e6dc2829d6">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(४)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="593" width="518" height="34" uuid="541bbaff-73c0-491d-b24f-de00849dba06"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[यदा कदाचित आगीचा प्रार्दुभाव झाल्यास अग्निशमन दलाच्या अधिकाऱ्याने दिलेल्या सुचनांचे पालन करून परवानाधारकांस ती आग इतरत्र पसरू न देण्यासाठी आवश्यक ती उपाययोजना तात्काळ करावी लागेल.]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="629" width="518" height="18" uuid="a38c2d68-cd87-4dda-a59a-9695c367a529">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[परवाना दिलेल्या जागेचा उपयोग मानवी वस्तीसाठी वा जनावरे किंवा पक्षी ठेवण्यासाठी करता येणार नाही.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="629" width="24" height="18" uuid="74dabd95-6f34-477f-bd67-b5b754c3a8a3">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(५)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="649" width="518" height="18" uuid="1ddecf96-8db6-4000-bbb5-535985067d18">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[आग पेटविणे वा ज्यामुळे सार्वजनिक सुरक्षेला धोका निर्माण होईल अशी कोणतीही कृती परवानाधारक परवाना दिलेल्या जागी करणार नाही.]]></text>
			</staticText>
			<staticText>
				<reportElement x="2" y="649" width="24" height="18" uuid="9c30c28d-6658-4d39-b684-eb962ab538b4"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(६) ]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="669" width="518" height="18" uuid="1a16ad6b-2725-471c-8e9d-73deea4bbe8e"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[परवाना दिलेल्या जागेच्या बाहेर ठळक जागी खालील तपशील फलक लावणे परवानाधारकावर बंधनकारक राहील. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="669" width="24" height="18" uuid="288e0eed-1d8f-4f31-be93-e2e21b182d13">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(७)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="689" width="518" height="34" uuid="b26419b8-1a13-472a-9ca7-8a218920f3fe">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(अ) परवानाधारकाचे नाव व पत्ता,  (ब) परवान्याचा क्रमांक व त्याची मुदत,  (क) परवानाधारकाच्या गैरहजेरीत नियंत्रण ठेवणाऱ्या व्यक्तीचे नाव व पत्ता]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="725" width="518" height="34" uuid="b2496452-b93b-4e5f-99e8-e7d6cb0d9416">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[ महानगरपालिकेच्या अधिकऱ्यांनी भेट दिल्यावर परवानाधारकाला द्यावयाच्या सुचनांसाठी "भेटी / सूचना रजिस्टर" परवानाधारकाला ठेवावे लागेल.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="689" width="24" height="34" uuid="ce68f18a-e724-41c7-ac00-1a1259f4b888">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(८)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="761" width="518" height="50" uuid="5c693fb0-73db-414f-b932-15964e347d77"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[नागपूर महानगरपालिका अधिनियम, १९४९ च्या कलम ३७६ च्या तरतूदीनुसार दिलेल्या या परवान्याव्यतिरिक्त अन्य कायदेशीर तरतुदीच्या अनुषंगाने कोणत्याही अधिनियमाखाली घ्यावे लागणारे परवाने देण्याची जबाबदारी परवानाधारकांवर असेल. त्यानंतरच सदर परवाना लागू राहील.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="725" width="24" height="34" uuid="86c26a2d-fe48-490b-b2c8-895171767475">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(९) ]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="485" width="24" height="30" uuid="18d73487-1cc6-449f-ae26-97f4355a8963"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(१)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="485" width="518" height="50" uuid="2c942849-2231-4a24-8be1-350da1df5d44">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[या परवान्याचा मुदत ३१ डिसेंबर रोजी संपणाऱ्या कॅलेंडर वर्षापर्यंत असेल. वर्षाच्या कुठल्याही महिन्यात परवाना प्राप्त झाल्यानंतर त्या वर्षाच्या ३१ डिसेंबर पर्यंत परवाना वैध राहील. परवानाधारकाला "नागपूर महानगरपालिका (विनिर्दिष्ट प्रयोजनासाठी / व्यवसायासाठी जागा वापरण्याचे) स्थायी आदेश, २०२० च्या तरतूदीचे पालन करावे लागेल. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="537" width="518" height="18" uuid="57b1740d-a92c-4fcd-b488-f148b459335b"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[ परवान्यात नमूद केलेल्या व्यवसाया व्यतिरिक्त इतर कोणताही व्यवसाय परवाना दिलेल्या जागेत करता येणार नाही.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="537" width="24" height="18" uuid="582f343e-061b-4cbc-b239-91baf5ebf335">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(२)]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="761" width="24" height="50" uuid="d5713520-4e5c-4043-86cf-498f81551b0b">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
