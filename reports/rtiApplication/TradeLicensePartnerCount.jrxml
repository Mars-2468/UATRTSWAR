			<staticText>
				<reportElement x="26" y="486" width="518" height="35" uuid="e896ab48-28ca-4471-a373-774436a32c3a">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[नागरिकांचे, त्यांच्या मिळकतीचे संरक्षण करण्याचे उद्देशाने व नागरिकांना उपद्रव होऊ नये यासाठी परवान्यातील अटी व शर्तींचे काटेकोरपणे पालन करावे लागेल.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="522" width="24" height="34" uuid="f93b3f76-a15a-40d8-bcf7-7ef4f658419f">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(४)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="522" width="518" height="34" uuid="4406f7a8-8c5e-4b1a-b62b-42a34fa11aed"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[यदा कदाचित आगीचा प्रार्दुभाव झाल्यास अग्निशमन दलाच्या अधिकाऱ्याने दिलेल्या सुचनांचे पालन करून परवानाधारकांस ती आग इतरत्र पसरू न देण्यासाठी आवश्यक ती उपाययोजना तात्काळ करावी लागेल.]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="558" width="518" height="18" uuid="d736484b-7cf9-4382-8690-cf7529a3e082">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[परवाना दिलेल्या जागेचा उपयोग मानवी वस्तीसाठी वा जनावरे किंवा पक्षी ठेवण्यासाठी करता येणार नाही.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="558" width="24" height="18" uuid="f26db866-b9d3-49ea-b81c-fa3ea7ad2882">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(५)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="578" width="518" height="18" uuid="2f2323bc-5bd9-40c2-b282-2c296f4fd5d2">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[आग पेटविणे वा ज्यामुळे सार्वजनिक सुरक्षेला धोका निर्माण होईल अशी कोणतीही कृती परवानाधारक परवाना दिलेल्या जागी करणार नाही.]]></text>
			</staticText>
			<staticText>
				<reportElement x="2" y="578" width="24" height="18" uuid="7fe199a0-e66a-41fc-936d-1213da9b504f"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(६) ]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="598" width="518" height="18" uuid="072b6c21-83e2-4149-9075-1968f5da16dc"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[परवाना दिलेल्या जागेच्या बाहेर ठळक जागी खालील तपशील फलक लावणे परवानाधारकावर बंधनकारक राहील. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="598" width="24" height="18" uuid="284e4bff-6554-41df-aa00-e6f974acef9e">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(७)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="618" width="518" height="34" uuid="5244d744-a6b7-4d29-a557-fa110115e8cd">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(अ) परवानाधारकाचे नाव व पत्ता,  (ब) परवान्याचा क्रमांक व त्याची मुदत,  (क) परवानाधारकाच्या गैरहजेरीत नियंत्रण ठेवणाऱ्या व्यक्तीचे नाव व पत्ता]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="654" width="518" height="34" uuid="4e859ce9-eb0d-4046-adad-1a31194eed56">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[ महानगरपालिकेच्या अधिकऱ्यांनी भेट दिल्यावर परवानाधारकाला द्यावयाच्या सुचनांसाठी "भेटी / सूचना रजिस्टर" परवानाधारकाला ठेवावे लागेल.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="618" width="24" height="34" uuid="49cfd0e7-f070-4851-9a14-ba3899ff7913">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(८)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="690" width="518" height="50" uuid="ec7d69ab-0d7b-4d2c-aedb-fcfd1828d59c"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[नागपूर महानगरपालिका अधिनियम, १९४९ च्या कलम ३७६ च्या तरतूदीनुसार दिलेल्या या परवान्याव्यतिरिक्त अन्य कायदेशीर तरतुदीच्या अनुषंगाने कोणत्याही अधिनियमाखाली घ्यावे लागणारे परवाने देण्याची जबाबदारी परवानाधारकांवर असेल. त्यानंतरच सदर परवाना लागू राहील.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="654" width="24" height="34" uuid="43599560-f8fb-4816-ab21-8060fc0accf2">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(९) ]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="414" width="24" height="30" uuid="56aec584-779d-4905-86d1-567ed4d54b01"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(१)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="414" width="518" height="50" uuid="e1ae65cf-9021-4969-96a7-ed72670f2ff2">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[या परवान्याचा मुदत ३१ डिसेंबर रोजी संपणाऱ्या कॅलेंडर वर्षापर्यंत असेल. वर्षाच्या कुठल्याही महिन्यात परवाना प्राप्त झाल्यानंतर त्या वर्षाच्या ३१ डिसेंबर पर्यंत परवाना वैध राहील. परवानाधारकाला "नागपूर महानगरपालिका (विनिर्दिष्ट प्रयोजनासाठी / व्यवसायासाठी जागा वापरण्याचे) स्थायी आदेश, २०२० च्या तरतूदीचे पालन करावे लागेल. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="466" width="518" height="18" uuid="45ce4753-ba87-4da7-be9f-5576544ba932"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[ परवान्यात नमूद केलेल्या व्यवसाया व्यतिरिक्त इतर कोणताही व्यवसाय परवाना दिलेल्या जागेत करता येणार नाही.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="466" width="24" height="18" uuid="d6ef911a-3b9b-4325-b02d-02f7a66f90de">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(२)]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="690" width="24" height="50" uuid="3e162838-464d-4629-bc67-3385e50d0a11">
