<!-- 2025-10-14T19:39:42 -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TMSZoneWiseSummary" pageWidth="1400" pageHeight="595" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="1300" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b1314ea3-9cac-4e56-afd1-abc915d5eec6">
	<parameter name="FROM_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    z.zone_name AS zone_name,
    TO_CHAR(TO_DATE($P{FROM_DATE}, 'DD/MM/YYYY'), 'DD/MM/YYYY') AS cleaning_date,
    s.shift_name AS shift,
    COALESCE(unit_counts.total_units, 0) AS total_units,
    COALESCE(block_counts.total_blocks, 0) AS total_blocks,
    COALESCE(SUM(CASE WHEN tc.toilet_condition = 'Clean' THEN 1 ELSE 0 END), 0) AS cleaned,
    COALESCE(SUM(CASE WHEN tc.toilet_condition = 'Damage' THEN 1 ELSE 0 END), 0) AS damage,
    COALESCE(SUM(CASE WHEN tc.toilet_condition = 'Blocked' THEN 1 ELSE 0 END), 0) AS blocked,
    COALESCE(SUM(CASE WHEN tc.toilet_condition = 'Locked' THEN 1 ELSE 0 END), 0) AS locked,
    COALESCE(block_counts.total_blocks, 0)
      - COALESCE(SUM(CASE WHEN tc.toilet_condition IN ('Clean', 'Damage', 'Blocked', 'Locked') THEN 1 ELSE 0 END), 0) AS skipped,
    COALESCE(SUM(CASE WHEN tc.toilet_condition = 'Clean' AND tc.workflowstatus = 5 THEN 1 ELSE 0 END), 0) AS rejected,
    COALESCE(SUM(CASE WHEN tc.toilet_condition = 'Clean' AND tc.workflowstatus = 1 THEN 1 ELSE 0 END), 0) AS approved,
    COALESCE(SUM(CASE WHEN tc.toilet_condition = 'Clean' AND tc.workflowstatus = 1 THEN 32.13 ELSE 0 END), 0) AS cost
FROM
    egovrti.toiletcleaning_zones z
CROSS JOIN (
    SELECT 'Morning' AS shift_name
    UNION ALL
    SELECT 'Afternoon'
    UNION ALL
    SELECT 'Night'
) s
LEFT JOIN egovrti.toilet_cleaning tc
    ON tc.zoneid = z.zone_id
    AND tc.shift = s.shift_name
    AND (
        tc.currentdate = TO_CHAR(TO_DATE($P{FROM_DATE}, 'DD/MM/YYYY'), 'YYYY-MM-DD')
     OR tc.currentdate = TO_CHAR(TO_DATE($P{FROM_DATE}, 'DD/MM/YYYY'), 'DD/MM/YYYY')
     OR tc.currentdate = TO_CHAR(TO_DATE($P{FROM_DATE}, 'DD/MM/YYYY'), 'DD-MM-YYYY')
     OR tc.currentdate = TO_CHAR(TO_DATE($P{FROM_DATE}, 'DD/MM/YYYY'), 'YYYY/MM/DD')
    )
    AND (tc.is_draft IS NULL OR tc.is_draft <> '1')
LEFT JOIN (
    SELECT bu.zone AS zone_id, COUNT(*) AS total_units
    FROM egovrti.toiletcleaning_blockunits bu
    GROUP BY bu.zone
) unit_counts ON unit_counts.zone_id = z.zone_id
LEFT JOIN (
    SELECT u.zone_id, COUNT(*) AS total_blocks
    FROM egovrti.toiletcleaning_unitnumbers u
    GROUP BY u.zone_id
) block_counts ON block_counts.zone_id = z.zone_id
GROUP BY
    z.zone_id, z.zone_name, s.shift_name, unit_counts.total_units, block_counts.total_blocks
ORDER BY
    z.zone_id, s.shift_name]]>
	</queryString>
