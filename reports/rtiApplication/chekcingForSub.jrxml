				<text><![CDATA[(ड)]]></text>
			</staticText>
			<staticText>
				<reportElement x="48" y="727" width="505" height="40" uuid="f7ccf542-e4a9-4612-ada6-a6d0bdd91273"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[रिट पिटीशन क्र. ६१७७/२००६ मनोहर खोरगडे वि. म.न.पा व ईतर या मध्ये मा. उच्च न्यायालय खंडपीठ यांनी वेळोवेळी पारित केल्याला आदेशाचे उल्घन होणार नाही. याची दक्षता घ्यावी.]]></text>
			</staticText>
			<staticText>
				<reportElement x="19" y="727" width="25" height="30" uuid="15e43124-cb37-4d98-8689-d6299a589965">
					<property name="com.jaspersoft.studio.unit.y" value="pixel"/>
				</reportElement>
				<textElement>
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[21]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="172" width="508" height="33" uuid="ab174c07-5a28-4403-b70e-3f8674f1f156"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[रस्त्यावर चूल पेटवून स्वयंपाक करण्यात सक्त मनाई आहे असे केल्यास रु. २०००/- दंड आकारण्यात येईल किंवा जप्त करण्यात येईल. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="49" y="767" width="504" height="20" uuid="3a4e257e-aa3c-4589-85a2-5d5f309a3bf4"/>
				<textElement>
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[नियम व अटी चे पालन न करण्यावर फौजदारी गुन्हा दाखल करण्यात येईल.

]]></text>
			</staticText>
			<staticText>
				<reportElement x="19" y="767" width="27" height="20" uuid="e57ae627-7152-433d-be95-329c6772908d"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<text><![CDATA[22]]></text>
			</staticText>
			<staticText>
				<reportElement x="44" y="135" width="510" height="36" uuid="ce005880-2d08-48f9-86c7-2ca7bc014824"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[प्रस्तुत धोरण अंतर्गत मनापाद्वारे देण्यात आलेली परवानगी कोणतेही कारण न सागंताना परत घेण्याचे किंवा निरस्तर करण्याचे संपुर्ण अधिकार महानगरपालिका आयुक्तांकडे राहतो.]]></text>
			</staticText>
			<staticText>
				<reportElement x="19" y="226" width="20" height="30" uuid="d721b6c2-b5e8-4031-8768-3a72461fed8f">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.y" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[14]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="226" width="508" height="33" uuid="e3bf4a8f-c37e-4023-b3a3-a49182c8f0ab"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[मंडप/मंच/स्वागतद्वार कमानीचे संरचने मुळे अपघात अगर धोका झाल्यास त्याची सर्वसी जबाबदारी संस्था/अर्जादारची राहील ]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="259" width="508" height="68" uuid="fe032da1-a9f9-46af-a1dc-b2b9816e220b"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[सदर परवानगी ही पी ओ पी व त्या समान सामग्रीच्या मूर्तीची स्थापना करण्यासाठी नसून, ही परवानगी मूर्तीची स्थापना केंद्रीय प्रदूषण नियंत्रण मंडळाने दि. 12/05/2020 रोजी पारित केलेल्या सुधारित मार्गदर्शन तत्वे तसेच महाराष्ट्र शासनाचे पर्यावरण व वातावरणीय बदल विभागाने दि. 26/04/2024 रोजी निर्गमित केलेल्या निर्देशांची पूर्तता करणारी असावी.]]></text>
			</staticText>
			<staticText>
				<reportElement x="19" y="259" width="20" height="40" uuid="099d251c-e59d-46b3-b0da-faf3898d373a">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.y" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[15]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="332" width="508" height="50" uuid="1e0d9092-c599-4371-aba9-0b9d6b56f2c4">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[गणेश मंडळाने पर्यावरण पूरक मुर्तीची स्थापना करण्यात यावी. तसेच मुर्तीच्या सजावटी करिता पर्यावरण पुरक साहित्याचा वापर करण्यात यावा व जलाशयाचे प्रदूषण थांबविण्याकरिता कृत्रिम तलावातच श्री गणेशाच्या मुर्तीचे विसर्जन करण्यात यावे.]]></text>
			</staticText>
			<staticText>
				<reportElement x="19" y="332" width="20" height="30" uuid="7c18b114-eab8-40cc-b3cd-3e997a6c6cf4">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.y" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[16]]></text>
			</staticText>
			<staticText>
				<reportElement x="19" y="382" width="20" height="30" uuid="39d90ef3-005c-47c7-9170-8cc0b070044a">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.y" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[17]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="382" width="508" height="51" uuid="b7bc9660-7ba8-4c75-bd66-09f71a16287d">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[मंडळाने केंद्रीय प्रदुषण नियंत्रण मंडळाचे दि. १२/०५/२०२० रोजी पारित केलेल्या सुधारित मार्गदर्शक तत्वे तसेच महाराष्ट्र शासनाचे पर्यावरण व वातावरणीय बदल विभागाने दि. २६/०४/२०२४ रोजी निर्गमित केलेल्या निर्देशांचे पालन करणे आवश्यक आहे.]]></text>
			</staticText>
			<staticText>
				<reportElement x="19" y="434" width="20" height="30" uuid="43c83b8e-f099-4467-b6e4-70921095ec32">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.y" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[18]]></text>
			</staticText>
			<staticText>
				<reportElement x="45" y="433" width="508" height="65" uuid="870f2759-a33b-4475-9d23-d61767eb9504">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[मंडळास परवानगी  मिळाल्यानंतर पीओपी मुर्तीची स्थापना केल्याचे आढळल्यास अशा मंडळाची परवानगी सक्षम प्राधिकरणाद्वारे रद्द करण्यात येईल तसेच मंडळाला पुढील वर्षापासुन काळ्या यादीत टाकुन त्यांच्यावर बंदी घालण्यात येईल तसेच मनपाच्या अधिकाऱ्यास तपासणी दरम्यान पीओपी मुर्ती स्थापना करतांना आढळुन आल्यास मंडळाचे / समितीचे पदाधिकारी यांच्यावर नियमानुसार दंडात्मक कारवाई करण्यात येईल.]]></text>
			</staticText>
			<staticText>
