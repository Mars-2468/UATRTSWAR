<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="GaneshMandappermission" pageWidth="595" pageHeight="950" whenNoDataType="NoDataSection" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isSummaryNewPage="true" whenResourceMissingType="Error" uuid="78239694-2992-474a-bf1f-cae7cac197a4">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="egvNmc"/>
	<parameter name="rtiapplrefid" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    mp.ganesh_mandap_permission_id ,
    TO_CHAR(TO_DATE(ra.registration_date, 'dd/mm/yyyy hh24:mi:ss'), 'dd/mm/yyyy') AS registration_date,
    ra.applicant_name,
    mp.address,
    TO_CHAR(TO_TIMESTAMP(mp.pavilion_start_date, 'yyyy-mm-dd'), 'dd/mm/yyyy') AS pavilion_start_date,
    TO_CHAR(TO_TIMESTAMP(mp.pavilion_end_date, 'yyyy-mm-dd'), 'dd/mm/yyyy') AS pavilion_end_date,
    mp.address_for_institution,
    mp.pavilion_length,
    mp.pavilion_breadth
FROM
    egovrti.ganesh_mandap_permission mp
    JOIN egovrti.rti_application ra ON mp.rti_ref_id = ra.rti_application_id
WHERE
    mp.rti_ref_id = $P{rtiapplrefid};]]>
	</queryString>
	<field name="ganesh_mandap_permission_id" class="java.lang.Long"/>
	<field name="registration_date" class="java.lang.String"/>
	<field name="applicant_name" class="java.lang.String"/>
	<field name="address" class="java.lang.String"/>
	<field name="pavilion_start_date" class="java.lang.String"/>
	<field name="pavilion_end_date" class="java.lang.String"/>
	<field name="address_for_institution" class="java.lang.String"/>
	<field name="pavilion_length" class="java.lang.String"/>
	<field name="pavilion_breadth" class="java.lang.String"/>
	<background>
