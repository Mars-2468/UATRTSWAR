					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(२)]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="690" width="24" height="50" uuid="e489a2ef-7e72-470a-9896-efd1a89085b3">
