			<staticText>
				<reportElement x="26" y="486" width="518" height="35" uuid="72231806-b731-421c-8bfb-1881c945b209">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[नागरिकांचे, त्यांच्या मिळकतीचे संरक्षण करण्याचे उद्देशाने व नागरिकांना उपद्रव होऊ नये यासाठी परवान्यातील अटी व शर्तींचे काटेकोरपणे पालन करावे लागेल.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="522" width="24" height="34" uuid="5ae6369e-f0e7-48e0-bc03-3eb6585790c8">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(४)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="522" width="518" height="34" uuid="f7d8e6e5-72cd-49a2-b85a-e6cee2ab5d42"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[यदा कदाचित आगीचा प्रार्दुभाव झाल्यास अग्निशमन दलाच्या अधिकाऱ्याने दिलेल्या सुचनांचे पालन करून परवानाधारकांस ती आग इतरत्र पसरू न देण्यासाठी आवश्यक ती उपाययोजना तात्काळ करावी लागेल.]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="558" width="518" height="18" uuid="e5972ccd-1448-4cb6-bb3d-8cdcdddaa5ca">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[परवाना दिलेल्या जागेचा उपयोग मानवी वस्तीसाठी वा जनावरे किंवा पक्षी ठेवण्यासाठी करता येणार नाही.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="558" width="24" height="18" uuid="8b7dda04-1aaa-4366-bba8-b1fca9869ca4">
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(५)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="578" width="518" height="18" uuid="3b5b3947-03b3-4d55-8438-053494cb57db">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[आग पेटविणे वा ज्यामुळे सार्वजनिक सुरक्षेला धोका निर्माण होईल अशी कोणतीही कृती परवानाधारक परवाना दिलेल्या जागी करणार नाही.]]></text>
			</staticText>
			<staticText>
				<reportElement x="2" y="578" width="24" height="18" uuid="97e74174-4da2-4bde-9aca-9dcf3329e4f2"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(६) ]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="598" width="518" height="18" uuid="bdcc59c9-e53a-4eab-9b4e-8bc917cdb216"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[परवाना दिलेल्या जागेच्या बाहेर ठळक जागी खालील तपशील फलक लावणे परवानाधारकावर बंधनकारक राहील. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="598" width="24" height="18" uuid="a96f5000-3b98-477d-acb7-a5977d03f3e6">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(७)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="618" width="518" height="34" uuid="9d89dc27-147a-4502-a655-792cd678edf6">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(अ) परवानाधारकाचे नाव व पत्ता,  (ब) परवान्याचा क्रमांक व त्याची मुदत,  (क) परवानाधारकाच्या गैरहजेरीत नियंत्रण ठेवणाऱ्या व्यक्तीचे नाव व पत्ता]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="654" width="518" height="34" uuid="783b630b-6184-4de5-bd04-190df794ba32">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[ महानगरपालिकेच्या अधिकऱ्यांनी भेट दिल्यावर परवानाधारकाला द्यावयाच्या सुचनांसाठी "भेटी / सूचना रजिस्टर" परवानाधारकाला ठेवावे लागेल.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="618" width="24" height="34" uuid="79e8505b-2c3e-4f09-b957-37383de6f0ed">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(८)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="690" width="518" height="50" uuid="fc199e5e-4ee9-4965-af30-1df891396948"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[नागपूर महानगरपालिका अधिनियम, १९४९ च्या कलम ३७६ च्या तरतूदीनुसार दिलेल्या या परवान्याव्यतिरिक्त अन्य कायदेशीर तरतुदीच्या अनुषंगाने कोणत्याही अधिनियमाखाली घ्यावे लागणारे परवाने देण्याची जबाबदारी परवानाधारकांवर असेल. त्यानंतरच सदर परवाना लागू राहील.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="654" width="24" height="34" uuid="7ddd2a2e-8b97-4994-b165-a6839041fb6e">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(९) ]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="414" width="24" height="30" uuid="0ee938c3-f98d-4a59-bcc5-1d60523779c8"/>
				<textElement textAlignment="Center">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[(१)]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="414" width="518" height="50" uuid="31c87634-44c9-42cc-bb2f-bdd3e2ecc93d">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[या परवान्याचा मुदत ३१ डिसेंबर रोजी संपणाऱ्या कॅलेंडर वर्षापर्यंत असेल. वर्षाच्या कुठल्याही महिन्यात परवाना प्राप्त झाल्यानंतर त्या वर्षाच्या ३१ डिसेंबर पर्यंत परवाना वैध राहील. परवानाधारकाला "नागपूर महानगरपालिका (विनिर्दिष्ट प्रयोजनासाठी / व्यवसायासाठी जागा वापरण्याचे) स्थायी आदेश, २०२० च्या तरतूदीचे पालन करावे लागेल. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="466" width="518" height="18" uuid="7dd1f2bb-4ced-4d77-ab57-fa8263d038f0"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<text><![CDATA[ परवान्यात नमूद केलेल्या व्यवसाया व्यतिरिक्त इतर कोणताही व्यवसाय परवाना दिलेल्या जागेत करता येणार नाही.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="466" width="24" height="18" uuid="9756ed52-fa29-407f-85b1-8bd8324f073d">
