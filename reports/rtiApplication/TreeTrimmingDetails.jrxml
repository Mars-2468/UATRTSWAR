	<parameter name="rtiapplrefid" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT *
FROM egovrti.tree_trimming_details tcd
JOIN egovrti.tree_trimming tc ON tcd.tree_trimming_id = tc.tree_trimming_id
WHERE tc.tree_trimming_id = $P{rtiapplrefid}]]>
	</queryString>
