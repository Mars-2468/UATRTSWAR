	</variable>
	<variable name="rejected_app" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{rejected_application}]]></variableExpression>
	</variable>
	<variable name="final_noc_issued" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{final_noc_issued}]]></variableExpression>
	</variable>
