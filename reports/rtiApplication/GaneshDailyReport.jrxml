<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="GaneshDailyReport" pageWidth="980" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="940" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d801ecdc-ec91-42ea-9dde-6b3a72aefc71">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Egov_Nmc"/>
	<parameter name="FROM_DATE" class="java.lang.String"/>
	<parameter name="TO_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    -- Zone Mapping
    CASE
        WHEN ra.zone = 1 THEN 'Laxmi Nagar Zone 1'
        WHEN ra.zone = 2 THEN 'Dharampeth Zone 2'
        WHEN ra.zone = 3 THEN 'Hanuman Nagar Zone 3'
        WHEN ra.zone = 4 THEN 'Dhantoli Zone 4'
        WHEN ra.zone = 5 THEN 'Nehru Nagar Zone 5'
        WHEN ra.zone = 6 THEN 'Gandhibag Zone 6'
        WHEN ra.zone = 7 THEN 'Satranjipura Zone 7'
        WHEN ra.zone = 8 THEN 'Lakadganj Zone 8'
        WHEN ra.zone = 9 THEN 'Aashi Nagar Zone 9'
        WHEN ra.zone = 10 THEN 'Mangalwari Zone 10'
        ELSE 'BLANK Application'
    END AS zone_name,
    CAST(ra.zone AS INTEGER) AS zone_no,

    -- Applications Received
    COUNT(CASE WHEN ra.workflow_status IN (0,1,2,3,5,9,10,11) THEN 1 END) AS application_received,

    -- In Process
    COUNT(CASE WHEN ra.workflow_status IN (0,9,10,11,2) THEN 1 END) AS application_inprocess,

    -- Police NOC
    COUNT(CASE WHEN ra.police_noc IS NOT NULL THEN 1 END) AS police_noc_issued,

    -- Traffic NOC
    COUNT(CASE WHEN ra.traffic_noc IS NOT NULL THEN 1 END) AS traffic_noc_issued,

    -- Fire NOC
    COUNT(CASE WHEN ra.fire_noc IS NOT NULL THEN 1 END) AS fire_noc_issued,

    -- Final NOC
    COUNT(CASE WHEN ra.workflow_status = 1 THEN 1 END) AS final_noc_issued,

    -- Rejected
    COUNT(CASE WHEN ra.workflow_status = 5 THEN 1 END) AS rejected_application

FROM egovrti.rti_application ra
WHERE ra.rti_application_number IS NOT NULL
  AND ra.rti_application_number != ''
  AND ra.department = 'ESTATE-DEPARTMENT'
  AND ra.rti_service_id = '90'
  AND date_trunc('day', date(ra.created_date)) 
    BETWEEN to_date($P{FROM_DATE}, 'dd/MM/yyyy') 
        AND to_date($P{TO_DATE}, 'dd/MM/yyyy')
 
GROUP BY ra.zone
ORDER BY zone_no;
]]>
	</queryString>
	<field name="zone_name" class="java.lang.String"/>
	<field name="zone_no" class="java.lang.Integer"/>
	<field name="application_received" class="java.lang.Long"/>
	<field name="application_inprocess" class="java.lang.Long"/>
	<field name="police_noc_issued" class="java.lang.Long"/>
	<field name="traffic_noc_issued" class="java.lang.Long"/>
	<field name="fire_noc_issued" class="java.lang.Long"/>
	<field name="final_noc_issued" class="java.lang.Long"/>
	<field name="rejected_application" class="java.lang.Long"/>
	<variable name="total_app" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{application_received}]]></variableExpression>
	</variable>
	<variable name="app_inprocess" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{application_inprocess}]]></variableExpression>
