<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="GaneshDashboard" pageWidth="1280" pageHeight="842" columnWidth="1162" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="e4cf8d60-b422-4d03-b104-dc06b3fac28e">
