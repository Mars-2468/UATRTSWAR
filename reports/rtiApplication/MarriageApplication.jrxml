						<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
					</reportElement>
					<textElement verticalAlignment="Middle">
						<font fontName="Arial Unicode MS" size="14"/>
					</textElement>
					<textFieldExpression><![CDATA["7. Affidavit(If necessary In case of doubtful cases) (प्रतिज्ञापत्र (संशयास्पद प्रकरणांमध्ये आवश्यक असल्यास)) :"]]></textFieldExpression>
				</textField>
