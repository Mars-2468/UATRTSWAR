	</parameter>
	<queryString>
		<![CDATA[SELECT 
    mp.*, 
    ra.*, 
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 1) AS first_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 2) AS second_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 3) AS third_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 4) AS fourth_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 5) AS fifth_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 6) AS sixth_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 7) AS seventh_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 8) AS eighth_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 9) AS ninth_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 10) AS tenth_url,
    SPLIT_PART(ra.pdf_upload_from_portal, ',', 11) AS eleventh_url,
    SPLIT_PART(mp.images_path, ',', 1) AS doc1_url,
    SPLIT_PART(mp.images_path, ',', 2) AS doc2_url,
    SPLIT_PART(mp.images_path, ',', 3) AS doc3_url,
    SPLIT_PART(mp.images_path, ',', 4) AS doc4_url,  
    SPLIT_PART(mp.images_path, ',', 5) AS doc5_url,
    SPLIT_PART(mp.images_path, ',', 6) AS doc6_url,
    SPLIT_PART(mp.images_path, ',', 7) AS doc7_url,
    SPLIT_PART(mp.images_path, ',', 8) AS doc8_url,
    SPLIT_PART(mp.images_path, ',', 9) AS doc9_url,
    SPLIT_PART(mp.images_path, ',', 10) AS doc10_url,
    SPLIT_PART(mp.images_path, ',', 11) AS doc11_url,
    SPLIT_PART(mp.images_path, ',', 12) AS doc12_url
FROM 
    egovrti.marriage_certificate mp
JOIN 
    egovrti.rti_application ra 
    ON mp.rti_ref_id = ra.rti_application_id 
WHERE 
    mp.rti_ref_id = $P{rtiapplrefid};]]>
	</queryString>
