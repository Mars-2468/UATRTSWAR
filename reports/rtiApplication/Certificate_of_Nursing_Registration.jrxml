	<parameter name="rtiapplrefid" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT rnr."name" as name,
   rnr.placeofnstaff as place,
   rnr.maternitypatients as maternitary_beds,
   rnr.nobedopatient as other_beds,
   rnr.rti_appl_ref_no as rts_app_no,
  TO_CHAR(TO_DATE(rnr.certificate_issued_date , 'dd-mm-yyyy HH24:MI:SS'), 'dd-mm-yyyy') AS to_date,
  TO_CHAR(TO_DATE(ra.registration_date, 'dd-mm-yyyy HH24:MI:SS'), 'dd-mm-yyyy') AS registrationdate
FROM
  egovrti.nursinghomes_reg_new rnr
JOIN
  egovrti.rti_application ra ON ra.rti_application_id = rnr.rti_ref_id
WHERE
  rnr.rti_ref_id = $P{rtiapplrefid};]]>
	</queryString>
	<field name="name" class="java.lang.String"/>
	<field name="place" class="java.lang.String"/>
	<field name="maternitary_beds" class="java.lang.String"/>
	<field name="other_beds" class="java.lang.String"/>
	<field name="rts_app_no" class="java.lang.String"/>
	<field name="to_date" class="java.lang.String"/>
	<field name="registrationdate" class="java.lang.String"/>
