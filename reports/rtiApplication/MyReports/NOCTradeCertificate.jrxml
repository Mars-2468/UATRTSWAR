	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="startDate" class="java.lang.String"/>
	<parameter name="endDate" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[select cfe.case_file_entry_number as enerynumber,
cfe .case_number as casenumber,
cfe .case_file_entry_number as enerynumber,
cfe .created_by as cby,
cfe .applicant_petitioner_name  as citizenNmae,
a.advocate_first_name as advname,
c.court_name  as cname,
cfe .case_filed_date as cdate
from egovlcms.case_file_entry cfe, egovlcms.advocate a ,egovlcms.court c 
where cfe .advocate_id =a.advocate_id and 
cfe .court_id =c.court_id and
to_date(cfe .case_filed_date ,'DD/MM/YYYY') between $P{startDate} and $P{endDate} ;]]>
	</queryString>
	<field name="enerynumber" class="java.lang.String"/>
	<field name="casenumber" class="java.lang.String"/>
	<field name="cby" class="java.lang.String"/>
	<field name="advname" class="java.lang.String"/>
