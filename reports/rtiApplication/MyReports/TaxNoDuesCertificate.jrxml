				</reportElement>
				<textElement textAlignment="Left">
					<font fontName="Arial Unicode MS" size="14" isBold="false" isUnderline="false"/>
				</textElement>
				<text><![CDATA[उपरोक्त संदर्भाकिंत विषयाच्या अनुषंगाने खालील नमूद मालमत्ता नागपूर महानगरपालिका कर]]></text>
			</staticText>
			<textField>
				<reportElement stretchType="RelativeToTallestObject" isPrintRepeatedValues="false" x="10" y="80" width="545" height="70" uuid="dcacdb36-1ba8-420f-916d-555bbdd2c932"/>
				<textElement textAlignment="Left">
					<font fontName="Arial Unicode MS" size="14" isBold="false" isUnderline="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["नोंदणी पुस्तिकेप्रमाणे वार्ड क्र. : "+$F{ward_number}+" घर क्र. : "+$F{house_no}+", मालमत्ताधारक: "+$F{property_holder_name}+" यांच्या नावाने दर्ज असून त्याचा युपीन क्र. : "+$F{upin_no}+" आहे."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="90" y="152" width="465" height="20" uuid="0fbccd74-ca10-4b56-a6a1-a889ba59341c"/>
				<textElement textAlignment="Left">
					<font fontName="Arial Unicode MS" size="14" isBold="false" isUnderline="false"/>
				</textElement>
				<text><![CDATA[उपरोक्त नमूद मालमत्तेकरीता GEOCIVIC प्रणाली नुसार मालमत्तेवरील मालमत्ता कराची देय]]></text>
			</staticText>
			<textField>
				<reportElement stretchType="RelativeToTallestObject" x="19" y="172" width="489" height="18" uuid="c79f1e4f-ebd9-4283-bc05-debcd037df8f"/>
				<textElement textAlignment="Left">
					<font fontName="Arial Unicode MS" size="14" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["रक्कम सन  "+new SimpleDateFormat("yyyy").format(new java.util.Date())+" पर्यंत नागपूर महानगरपालिका निधीत जमा झालेली आहे."]]></textFieldExpression>
			</textField>
