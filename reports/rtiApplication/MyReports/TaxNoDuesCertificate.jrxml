				<textElement textAlignment="Left">
					<font fontName="Arial Unicode MS" size="14" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["संदर्भ :-  आपले अर्ज दि. "+new SimpleDateFormat("dd-MM-yyyy").format(new java.util.Date())+" अन्वये."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="88" y="58" width="465" height="20" uuid="28066213-191a-4b44-a411-ad9873ab591e">
