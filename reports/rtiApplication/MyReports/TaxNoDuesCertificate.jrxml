			<textField>
				<reportElement stretchType="RelativeToTallestObject" x="26" y="52" width="525" height="138" uuid="f0134c00-b8a4-4000-9ef1-c493a5e20a19"/>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Arial Unicode MS" size="14" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["श्री./श्रीमती: "+$F{property_holder_name}+"\n"+" मो. नं.: "+(($F{tax_mobile_no} != null && $F{tax_mobile_no} == "0" && $F{tax_mobile_no} != "") ? $F{tax_mobile_no} : "-")+"\n"+"\n"+"विषय :- ना देय प्रमाणपत्र मिळण्याबाबत."+"\n"+"युपीन क्र.: "+$F{upin_no}+"\n"+"इंडेक्स क्र.: "+$F{index_no}
]]></textFieldExpression>
			</textField>
		</band>
