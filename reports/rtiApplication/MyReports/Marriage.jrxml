	<parameter name="rtiapplrefid" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
  mp.*,
  ra.*,
  SPLIT_PART(mp.images_path, ',', 2) AS second_url,
  SPLIT_PART(mp.images_path, ',', 4) AS fourth_url,
  SPLIT_PART(mp.images_path, ',', 12) AS twelveth_url,
  to_char(TO_DATE(mp.marriage_date,'yyyy-mm-dd'),'dd-mm-yyyy') as marriage_datee,
  CASE 
        WHEN mp.zone_no = 1 THEN 'Zone No.1 - Laxmi Nagar'
        WHEN mp.zone_no = 2 THEN 'Zone No.2 - Dharmpeth'
        WHEN mp.zone_no = 3 THEN 'Zone No.3 - Hanuman Nagar'
        WHEN mp.zone_no = 4 THEN 'Zone No.4 - Dhantoli'
        WHEN mp.zone_no = 5 THEN 'Zone No.5 - Nehru Nagar'
        WHEN mp.zone_no = 6 THEN 'Zone No.6 - Gandhibag'
        WHEN mp.zone_no = 7 THEN 'Zone No.7 - Satranjipura'
        WHEN mp.zone_no = 8 THEN 'Zone No.8 - Lakadganj'
        WHEN mp.zone_no = 9 THEN 'Zone No.9 - Aashi Nagar'
        WHEN mp.zone_no = 10 THEN 'Zone No.10 - Mangalwari'
    END AS zone_no1,
    mp.* 
FROM
  egovrti.marriage_certificate mp,
  egovrti.rti_application ra
WHERE
  mp.rti_ref_id = ra.rti_application_id
  AND mp.rti_ref_id = $P{rtiapplrefid};]]>
	</queryString>
