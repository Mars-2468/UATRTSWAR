				<textElement textAlignment="Justified">
					<font fontName="Arial Unicode MS" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{marriage_datee}+" , "+$F{marriage_place}+" येथे विधि संपन्न झाला त्याची महाराष्ट्र विवाह मंडळाचे विनियमन व विवाह नोंदणी विधेयक अन्वये ठेवण्यात आलेल्या अनुक्रमांक:- "+" "+$F{rti_appl_ref_no}+" "+$F{zone_no1} +" नागपूर येथे दिनांक " +new java.text.SimpleDateFormat("dd-MM-yyyy").format(new java.util.Date())
+ " रोजी माझ्या कडून नोंदणी करण्यात आली आहे."]]></textFieldExpression>
