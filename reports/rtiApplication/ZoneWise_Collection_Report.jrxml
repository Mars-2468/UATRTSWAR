	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="NMCDataAdapter.xml"/>
	<parameter name="PERIOD" class="java.lang.String"/>
	<queryString>
		<![CDATA[WITH filtered_data AS (
    SELECT *
    FROM egovrti.misc_application
    WHERE 
        ($P{PERIOD} = 'month'   AND date::date >= date_trunc('month', CURRENT_DATE)::date
                                 AND date::date < (date_trunc('month', CURRENT_DATE) + INTERVAL '1 month')::date)
     OR ($P{PERIOD} = 'quarter' AND date::date >= date_trunc('quarter', CURRENT_DATE)::date
                                 AND date::date < (date_trunc('quarter', CURRENT_DATE) + INTERVAL '3 months')::date)
     OR ($P{PERIOD} = 'year'    AND date::date >= date_trunc('year', CURRENT_DATE)::date
                                 AND date::date < (date_trunc('year', CURRENT_DATE) + INTERVAL '1 year')::date)
),
zone_summary AS (
    SELECT
        zone,
        COUNT(*) AS no_of_receipts,
        SUM(amount) AS zone_total
    FROM filtered_data
    GROUP BY zone
),
total_summary AS (
    SELECT
        SUM(no_of_receipts) AS total_receipts,
        SUM(zone_total) AS grand_total
    FROM zone_summary
),
combined AS (
    SELECT
        zs.zone AS zone_name,
        zs.no_of_receipts,
        zs.zone_total,
        ROUND((zs.zone_total / ts.grand_total) * 100, 1) AS percentage_of_total
    FROM zone_summary zs
    CROSS JOIN total_summary ts

    UNION ALL

    SELECT
        'All Zones' AS zone_name,
        SUM(zs.no_of_receipts) AS no_of_receipts,
        SUM(zs.zone_total) AS zone_total,
        100.0 AS percentage_of_total
    FROM zone_summary zs
)
SELECT *
FROM combined
ORDER BY
    CASE WHEN zone_name = 'All Zones' THEN 2 ELSE 1 END,
    zone_name;]]>
	</queryString>
	<field name="zone_name" class="java.lang.String"/>
	<field name="no_of_receipts" class="java.math.BigDecimal"/>
	<field name="zone_total" class="java.math.BigDecimal"/>
	<field name="percentage_of_total" class="java.math.BigDecimal"/>
	<variable name="s .no" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[new Integer(1)]]></variableExpression>
	</variable>
	<variable name="no_of_receipts" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{no_of_receipts}]]></variableExpression>
	</variable>
