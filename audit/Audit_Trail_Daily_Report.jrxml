	<queryString>
		<![CDATA[select AUDIT_TRAIL_ID, ENTITY_ID, ENTITY_NAME, ENTITY_PROPERTY,
ENTITY_PROPERTY_OLD_VALUE, ENTITY_PROPERTY_NEW_VALUE,
OPERATION_TYPE, ACTOR_NAME, TRANSACTION_TIME,TO_DATE(at.TRANSACTION_DATE,'dd-mm-yyyy') TRANSACTION_DATE
from audit_trail at where
TO_DATE(at.TRANSACTION_DATE,'dd-mm-yyyy') = trunc(sysdate)
order by entity_name,entity_id,entity_property,transaction_time desc]]>
	</queryString>
